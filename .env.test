# Environnement de test (php vendor/bin/phpunit, dans le conteneur applicatif).
# tests/bootstrap.php redirige les variables sensibles vers des ressources isolées, avant le démarrage du noyau :
#   base maître master_mv_test (tenant fictif « mvtest », hôte mvtest.test), base tenant db_mv_contract_test
#   (clonée depuis db_mv_test_booktypes à chaque lancement), Redis base 2, Messenger en mémoire, mails vers null://,
#   IA remplacée par App\Tests\Fake\FakeAnthropicService (config/services_test.yaml).
# Les autres variables (clés JWT, APP_SECRET...) viennent de l'environnement du conteneur.
KERNEL_CLASS='App\Kernel'
SYMFONY_DEPRECATIONS_HELPER=999999
# Assistant IA des landing pages : modèles par défaut du code, quel que soit le réglage du .env de production
LANDING_AI_MODEL_PAGE=
LANDING_AI_MODEL_IMAGES=
