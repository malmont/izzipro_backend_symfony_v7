# ✅ Configuration de Symfony
KERNEL_CLASS='App\Kernel'
APP_ENV=dev               # ou prod selon l'environnement souhaité
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999

# ✅ Connexion à la base de données
DATABASE_URL=pgsql://fake_user:fake_password@db:5432/fake_db

# ✅ Paramètres Doctrine (ORM)
DOCTRINE_DB_DRIVER=pdo_pgsql
DOCTRINE_DB_NAME=fake_db
DOCTRINE_DB_USER=fake_user
DOCTRINE_DB_PASSWORD=fake_password
DOCTRINE_DB_HOST=db
DOCTRINE_DB_PORT=5432

# ✅ Configuration des logs
LOG_LEVEL=debug

# ✅ Paramètres pour Panther (tests end-to-end)
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots

# ✅ Configuration du mailer (factice pour éviter les erreurs)
MAILER_DSN=null://null

# ✅ Configuration des CORS (si nécessaire)
CORS_ALLOW_ORIGIN=*

# ✅ Configuration du cache (optionnel)
CACHE_URL=redis://localhost:6379

# ✅ Paramètres de sécurité (exemple)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=fake_passphrase
