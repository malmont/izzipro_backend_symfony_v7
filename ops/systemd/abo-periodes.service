# Droits d'abonnement (lot ABO-1, 19/11/2026) : réémission des périodes payées non traitées, report ou perte des droits échus.
# Installation : sudo cp ops/systemd/abo-periodes.{service,timer} /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now abo-periodes.timer
[Unit]
Description=Arkanoa : passage horaire des droits d'abonnement
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec -w /var/www symfony_app_v2 php bin/console app:abo:periodes --no-interaction
