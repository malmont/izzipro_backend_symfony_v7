# Paiements des offres (lot PROVISION-3, 18/11/2026) : réconciliation nocturne avec Stripe des abonnements branchés, purge du journal.
# Installation : sudo cp ops/systemd/platform-offers-reconcile.{service,timer} /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now platform-offers-reconcile.timer
[Unit]
Description=Arkanoa : réconciliation des paiements des offres avec Stripe
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec -w /var/www symfony_app_v2 php bin/console app:platform:offers:reconcile --all --no-interaction
