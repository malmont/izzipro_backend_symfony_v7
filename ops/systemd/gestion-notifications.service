# Application de gestion, lot N1 (11/11/2026) : notifications sur téléphone, passage quotidien de chaque site à 10 h, heure du magasin.
# Installation : sudo cp ops/systemd/gestion-notifications.{service,timer} /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now gestion-notifications.timer
[Unit]
Description=Arkanoa : notifications de l'application de gestion
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec -w /var/www symfony_app_v2 php bin/console app:gestion:notifications:envoyer --no-interaction
