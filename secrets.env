# Connexion pour le Tenant User (opérations dans les bases des tenants)
# Le nom de la base sera remplacé dynamiquement par Symfony
DATABASE_URL_TENANT=postgresql://tenant_user:v2vadmin@dbtenant@972@${POSTGRES_HOST}:${POSTGRES_PORT}/DB_NAME_PLACEHOLDER

# Connexion pour le DB Creator (création des nouvelles bases)
DATABASE_URL_CREATOR=postgresql://db_creator:v2vadmin@dbcreator@972@${POSTGRES_HOST}:${POSTGRES_PORT}/postgres

MASTER_DATABASE_URL=postgresql://master_user:v2vadmin@dbmaster@972@${POSTGRES_HOST}:${POSTGRES_PORT}/master
