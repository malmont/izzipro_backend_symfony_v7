# Utilise l'image officielle de Nginx
FROM nginx:latest

# Supprime la configuration par défaut
RUN rm /etc/nginx/conf.d/default.conf

# Copie la configuration personnalisée de Nginx
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf

# Crée le dossier public s'il n'existe pas pour éviter les erreurs
RUN mkdir -p /var/www/public

# Permissions pour le dossier public
RUN chmod -R 755 /var/www/public && chown -R www-data:www-data /var/www/public

# 🔧 Installer les outils de diagnostic réseau
RUN apt-get update && apt-get install -y \
    iputils-ping \       # Pour la commande ping
    net-tools \          # Pour netstat et ifconfig
    curl \               # Pour tester des requêtes HTTP
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Expose le port 80
EXPOSE 80

# Commande pour démarrer Nginx
CMD ["nginx", "-g", "daemon off;"]
