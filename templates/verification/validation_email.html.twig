{# templates/emails/validation_email.html.twig #}
{% extends 'base.email.html.twig' %}

{# Langue du client (03/11/2026) : `locale` (fr|en), domaine `emails` #}
{% block title %}{{ 'verification.title'|trans({}, 'emails', locale)|raw }}{% endblock %}

{% block body %}
<div class="container mt-5">
    {% if logoUrl is defined and logoUrl %}
        <div class="text-center mb-4">
            <img src="{{ logoUrl }}" alt="{{ fromName }} Logo" style="max-width: 200px;">
        </div>
    {% endif %}

    {% if fromName %}
        <div class="text-center mb-4">
            <h2>{{ fromName }}</h2>
        </div>
    {% endif %}

    <div class="alert alert-info" role="alert">
        <h4 class="alert-heading">{{ 'verification.greeting'|trans({'%name%': user.firstname|e}, 'emails', locale)|raw }}</h4>
        <p>{{ 'verification.intro'|trans({}, 'emails', locale)|raw }}</p>
        <p class="mb-0"><a href="{{ verificationUrl }}">{{ 'verification.link'|trans({}, 'emails', locale)|raw }}</a></p>
        <hr>
        <p class="mb-0">{{ 'verification.ignore'|trans({}, 'emails', locale)|raw }}</p>
    </div>
</div>
{% endblock %}