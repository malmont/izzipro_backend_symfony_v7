{# templates/emails/verified_account.html.twig #}
{% extends 'base.email.html.twig' %}

{% block title %}Compte Vérifié{% endblock %}

{% block body %}
<div class="container mt-5">
    {% if emailConfig and emailConfig.logo %}
        <div class="text-center mb-4">
            <img src="{{ domain ~ emailConfig.logo }}" alt="{{ emailConfig.fromName }}" style="max-width: 200px;">
        </div>
    {% endif %}
    {% if emailConfig and emailConfig.fromName %}
        <div class="text-center mb-4">
            <h2>{{ emailConfig.fromName }}</h2>
        </div>
    {% endif %}
    <div class="alert alert-success" role="alert">
        <h4 class="alert-heading">Félicitations, {{ user.firstname }}!</h4>
        <p>Votre compte a été vérifié avec succès.</p>
        <hr>
        <p class="mb-0">Vous pouvez maintenant vous connecter et profiter de toutes les fonctionnalités de notre site.</p>
    </div>
</div>
{% endblock %}
