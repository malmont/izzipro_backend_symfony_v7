{# templates/verification/success.html.twig #}
{# Attention : J'ai changé le 'extends' pour base.html.twig car c'est une page web, pas un email #}
{% extends 'base.html.twig' %}

{% block title %}Compte Vérifié{% endblock %}

{% block body %}
<div class="container mt-5">
    
    {# 1. UTILISATION DE LA VARIABLE PRÉ-CALCULÉE 'logoUrl' #}
    {% if logoUrl is defined and logoUrl %}
        <div class="text-center mb-4">
            <img src="{{ logoUrl }}" alt="Logo" style="max-width: 200px;">
        </div>
    {% elseif emailConfig and emailConfig.fromName %}
        {# Fallback texte si pas d'image #}
        <div class="text-center mb-4">
            <h2>{{ emailConfig.fromName }}</h2>
        </div>
    {% endif %}

    <div class="alert alert-success" role="alert">
        <h4 class="alert-heading">Félicitations, {{ user.firstname }} !</h4>
        <p>Votre compte a été vérifié avec succès.</p>
        <hr>
        <p class="mb-0">Vous pouvez maintenant vous connecter et profiter de toutes les fonctionnalités de notre site.</p>
        
        {# Petit bouton de connexion pour l'UX #}
        <div class="mt-3">
            <a href="/login" class="btn btn-primary">Se connecter</a>
        </div>
    </div>
</div>
{% endblock %}