{% extends 'base.email.html.twig' %}

{% block title %}Paiement reçu pour le livre « {{ book.title }} »{% endblock %}

{% block body %}
<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; color: #2d3748; background-color: #f7fafc; padding: 25px 0;">
    <tr>
        <td align="center">
            <table width="600" border="0" cellspacing="0" cellpadding="0" style="background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">
                
                <!-- HEADER -->
                <tr>
                    <td align="center" style="background: linear-gradient(135deg, #15803d 0%, #166534 100%); padding: 30px 20px;">
                        <h1 style="color: #ffffff; margin: 0; font-size: 22px; font-weight: 700;">🎉 Nouveau paiement reçu !</h1>
                        <p style="color: #bbf7d0; margin: 6px 0 0 0; font-size: 14px;">Mémoires Vivantes — Notification de commande</p>
                    </td>
                </tr>

                <!-- CONTENU -->
                <tr>
                    <td style="padding: 30px;">
                        <p style="font-size: 16px; color: #1e293b; margin-top: 0;">
                            Bonne nouvelle ! Le client vient de finaliser le règlement en ligne pour son ouvrage.
                        </p>

                        <div style="background-color: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px; padding: 20px; margin: 25px 0;">
                            <h3 style="margin: 0 0 12px 0; font-size: 15px; color: #166534; border-bottom: 1px solid #dcfce7; padding-bottom: 8px;">
                                📋 Détails du règlement
                            </h3>
                            <table width="100%" border="0" cellspacing="0" cellpadding="6" style="font-size: 14px;">
                                <tr>
                                    <td style="color: #4b5563;">Livre :</td>
                                    <td align="right" style="font-weight: 600; color: #111827;">{{ book.title }}</td>
                                </tr>
                                <tr>
                                    <td style="color: #4b5563;">Email client :</td>
                                    <td align="right" style="color: #111827;">{{ customerEmail }}</td>
                                </tr>
                                <tr>
                                    <td style="color: #4b5563;">Format :</td>
                                    <td align="right" style="color: #374151; text-transform: uppercase;">{{ book.format }}</td>
                                </tr>
                                <tr>
                                    <td style="color: #4b5563;">Montant réglé :</td>
                                    <td align="right" style="font-size: 16px; font-weight: 800; color: #15803d;">
                                        {{ amountPaid|number_format(2, ',', ' ') }} {{ currency }}
                                    </td>
                                </tr>
                                <tr>
                                    <td style="color: #4b5563;">Statut du livre :</td>
                                    <td align="right" style="font-weight: 700; color: #15803d;">✅ PAYÉ</td>
                                </tr>
                            </table>
                        </div>

                        <p style="font-size: 14px; color: #475569;">
                            Le statut du livre a été mis à jour automatiquement à <strong>« Payé »</strong>. Vous pouvez désormais déclencher l'impression physique et l'expédition via le tableau de bord.
                        </p>
                    </td>
                </tr>

                <!-- FOOTER -->
                <tr>
                    <td align="center" style="background-color: #f8fafc; padding: 15px; border-top: 1px solid #e2e8f0; font-size: 12px; color: #94a3b8;">
                        Notification automatique du système de paiement Stripe Connect.
                    </td>
                </tr>

            </table>
        </td>
    </tr>
</table>
{% endblock %}
