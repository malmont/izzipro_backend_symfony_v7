{% extends 'base.email.html.twig' %}

{# Prévention des pertes, lot L1-b : résumé du jour. Deux nombres et une journée : aucun nom, aucun détail d'un constat ; un seul lien, vers l'écran des constats nouveaux.
   `siteLine`, jamais `signature` : l'envoi commun remplace `signature` par celle de la configuration d'envoi du site (nom, lien, HTML). #}
{% block title %}{{ title }}{% endblock %}

{% block body %}
<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; color: #2d3748; background-color: #f7fafc; padding: 25px 0;">
    <tr>
        <td align="center">
            <table width="600" border="0" cellspacing="0" cellpadding="0" style="background-color: #ffffff; border-radius: 12px; overflow: hidden;">
                <tr>
                    <td align="center" style="background: #1e293b; padding: 28px 20px;">
                        <h1 style="color: #ffffff; margin: 0; font-size: 20px; font-weight: 700;">{{ title }}</h1>
                    </td>
                </tr>
                <tr>
                    <td style="padding: 30px; font-size: 15px; color: #1e293b;">
                        {# Courriel d'exercice (lot EX-1) : bandeau en tête ; absent du courriel du jour #}
                        {% if exerciseBanner is defined and exerciseBanner %}<p style="margin-top: 0; padding: 12px 14px; background: #fef3c7; border: 1px solid #f59e0b; border-radius: 8px; color: #78350f; font-weight: 600;">{{ exerciseBanner }}</p>{% endif %}
                        <p style="margin-top: 0;">{{ greeting }}</p>
                        <p>{{ message }}</p>
                        <table width="100%" border="0" cellspacing="0" cellpadding="6" style="font-size: 14px; background: #f8fafc; border-radius: 8px; margin: 20px 0;">
                            {% for label, value in rows %}<tr><td style="color: #64748b;">{{ label }}</td><td align="right" style="font-weight: 600;">{{ value }}</td></tr>{% endfor %}
                        </table>
                        {# Lot L4-d : le bilan de la veille, des nombres seulement #}
                        {% if evening is defined and evening|length > 0 %}<p style="margin-bottom: 4px; font-weight: 600;">{{ eveningTitle }}</p>
                        <table width="100%" border="0" cellspacing="0" cellpadding="6" style="font-size: 14px; background: #f8fafc; border-radius: 8px; margin: 0 0 20px 0;">
                            {% for label, value in evening %}<tr><td style="color: #64748b;">{{ label }}</td><td align="right" style="font-weight: 600;">{{ value }}</td></tr>{% endfor %}
                        </table>{% endif %}
                        <p>{{ nextStep }}</p>
                        {# Lien direct vers l'écran (lot LIEN) : la seule adresse du courriel ; absent quand le site n'a pas d'adresse connue #}
                        {% if linkUrl is defined and linkUrl %}<p style="margin: 22px 0;"><a href="{{ linkUrl }}" style="display: inline-block; padding: 10px 18px; background: #1e293b; color: #ffffff; border-radius: 8px; text-decoration: none; font-weight: 600;">{{ linkLabel }}</a></p>{% endif %}
                        <p style="color: #64748b; font-size: 13px;">{{ notice }}</p>
                        <p style="color: #64748b; font-size: 13px; margin-bottom: 0;">{{ siteLine }}</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
{% endblock %}
