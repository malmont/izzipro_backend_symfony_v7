{% extends 'base.email.html.twig' %}

{# Langue du client (03/11/2026) : `locale` (fr|en), domaine `emails` ; date au format de la langue (fr : inchangé) #}
{% block title %}{{ 'email_changed.subject'|trans({}, 'emails', locale)|raw }}{% endblock %}

{% block body %}
<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
    <tr>
        <td align="center">
            <table width="600" border="0" cellspacing="0" cellpadding="0" style="background-color: #ffffff; border-radius: 12px; overflow: hidden;">
                <tr>
                    <td align="center" style="background: #1e293b; padding: 28px 20px;">
                        <h1 style="color: #ffffff; margin: 0; font-size: 20px; font-weight: 700;">{{ 'email_changed.subject'|trans({}, 'emails', locale)|raw }}</h1>
                    </td>
                </tr>
                <tr>
                    <td style="padding: 30px; font-size: 15px; color: #1e293b;">
                        {% set changedAtText = locale == 'fr' ? changedAt|date('d/m/Y à H:i') : changedAt|format_datetime('medium', 'short', locale=intlLocale) %}
                        <p style="margin-top: 0;">{{ 'email_changed.greeting'|trans({'%name%': firstname|default('')|e}, 'emails', locale)|raw }}</p>
                        <p>{{ 'email_changed.body'|trans({'%date%': changedAtText, '%old%': oldEmail|e, '%new%': newEmail|e}, 'emails', locale)|raw }}</p>
                        <p>{{ 'email_changed.nothing_to_do'|trans({}, 'emails', locale)|raw }}</p>
                        <p>{{ 'email_changed.not_you'|trans({}, 'emails', locale)|raw }}</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
{% endblock %}
