{% extends 'base.email.html.twig' %}

{# Langue du client (03/11/2026) : `locale` (fr|en), domaine `emails` ; montants dans la devise du site (`currency`, CAD à défaut) au format de la langue et du pays du site (`intlLocale`) #}
{% block title %}{{ 'order.title'|trans({'%reference%': order.reference}, 'emails', locale)|raw }}
{% endblock %}

{% block body %}
	<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: Arial, sans-serif; line-height: 1.6;">
		<tr>
			<td align="center" style="padding: 20px;">
				<table width="600" border="0" cellspacing="0" cellpadding="20" style="border: 1px solid #ddd; border-radius: 8px;">

					{% if logoUrl is defined and logoUrl %}
						<tr>
							<td align="center" style="padding-bottom: 20px; border-bottom: 1px solid #eee;"><img src="{{ logoUrl }}" alt="{{ fromName }}" style="max-width: 200px;"></td>
						</tr>
					{% elseif fromName is defined %}
						<tr>
							<td align="center" style="padding-bottom: 20px; border-bottom: 1px solid #eee;">
								<h1 style="margin:0;">{{ fromName }}</h1>
							</td>
						</tr>
					{% endif %}

					<tr>
						<td style="padding: 30px;">
							<h2 style="color: #333;">{{ 'order.thanks'|trans({'%name%': order.userId.firstname|e}, 'emails', locale)|raw }}</h2>
							<p>{{ 'order.recorded'|trans({'%reference%': order.reference|e}, 'emails', locale)|raw }}</p>

							<h3 style="margin-top: 30px; border-bottom: 2px solid #eee; padding-bottom: 5px;">{{ 'order.details'|trans({}, 'emails', locale)|raw }}</h3>

							{# BOUCLE ITEMS #}
							{% for itemData in itemsData %}
								{% set item = itemData.entity %}
								<table width="100%" border="0" cellspacing="0" cellpadding="5" style="margin-bottom: 10px; border-bottom: 1px dashed #eee;">
									<tr>
										<td style="font-size: 15px;">
											{{ item.quantity }}
											{{ itemData.saleUnit ? itemData.saleUnit : 'pcs' }}
											x
											{{ item.productVariant.product.name }}

											{# OPTION 1 : BOOKING #}
											{% if itemData.booking %}
												<div style="margin-top: 5px; color: #0066cc; font-size: 13px;">
													{{ 'order.booking'|trans({'%start%': itemData.booking.start|e, '%end%': itemData.booking.end|e}, 'emails', locale)|raw }}
												</div>
											{% endif %}

											{# OPTION 2 : VARIANTES #}
											<div style="font-size: 13px; color: #666;">
												{% for k, v in itemData.legacy %}
													{{ k }}:
													{{ v }}
													{% if not loop.last %}
														-
													{% endif %}
												{% endfor %}
												{% for k, v in itemData.options %}
													{{ k }}:
													{{ v }}
													{% if not loop.last %}
														-
													{% endif %}
												{% endfor %}
											</div>
										</td>

										<td align="right" style="font-size: 15px;">
											{{ (item.totalPrice / 100) | format_currency(currency|default('CAD'), {}, intlLocale|default(locale|default('fr'))) }}
										</td>
									</tr>
								</table>
							{% endfor %}

							<hr
							style="border: 0; border-top: 1px dashed #ccc; margin: 20px 0;">

							{# TOTAUX DÉTAILLÉS #}
							<table
								width="100%" border="0" cellspacing="0" cellpadding="5">
								{# Sous-total #}
								{% if order.subTotal is not null %}
									<tr>
										<td style="font-size: 14px; color: #666;">{{ (order.pricesIncludeTax ? 'order.subtotal_incl' : 'order.subtotal')|trans({}, 'emails', locale)|raw }}</td>
										<td align="right" style="font-size: 14px;">
											{{ (order.subTotal / 100) | format_currency(currency|default('CAD'), {}, intlLocale|default(locale|default('fr'))) }}
										</td>
									</tr>
								{% endif %}


								{# Livraison #}
								{% if order.shippingCost is not null %}
									<tr>
										<td style="font-size: 14px; color: #666;">{{ 'order.shipping'|trans({}, 'emails', locale)|raw }}</td>
										<td align="right" style="font-size: 14px;">
											{{ (order.shippingCost / 100) | format_currency(currency|default('CAD'), {}, intlLocale|default(locale|default('fr'))) }}
										</td>
									</tr>
								{% endif %}


								{# Taxes #}
								{% if order.totalTax is not null %}
									<tr>
										<td style="font-size: 14px; color: #666;">{{ (order.pricesIncludeTax ? 'order.tax_included' : 'order.taxes')|trans({}, 'emails', locale)|raw }}</td>
										<td align="right" style="font-size: 14px;">
											{{ (order.totalTax / 100) | format_currency(currency|default('CAD'), {}, intlLocale|default(locale|default('fr'))) }}
										</td>
									</tr>
								{% endif %}

								{# Total Final #}
								<tr>
									<td style="font-size: 18px; font-weight: bold; border-top: 1px solid #ddd; padding-top: 10px;">{{ 'order.total'|trans({}, 'emails', locale)|raw }}</td>
									<td align="right" style="font-size: 18px; font-weight: bold; color: #007bff; border-top: 1px solid #ddd; padding-top: 10px;">
										{{ (order.totalAmount / 100) | format_currency(currency|default('CAD'), {}, intlLocale|default(locale|default('fr'))) }}
									</td>
								</tr>
							</table>

							{# --- AJOUT DU BLOC ADRESSE ICI --- #}
							<h3 style="margin-top: 30px; border-bottom: 2px solid #eee; padding-bottom: 5px;">
								{{ (order.carrier ? 'order.shipping_address' : 'order.billing_address')|trans({}, 'emails', locale)|raw }}
							</h3>

							{% set adr = order.shippingAdress %}
							{% if adr %}
								<address style="font-style: normal; line-height: 1.5; background-color: #f9f9f9; padding: 15px; border-radius: 5px; border: 1px solid #eee; font-size: 14px; color: #333;">
									<strong>{{ adr.firstname }}
										{{ adr.lastname }}</strong><br>
									{% if adr.company %}
										{{ adr.company }}<br>
									{% endif %}

									{{ adr.address }}<br>
									{% if adr.complement %}
										{{ adr.complement }}<br>
									{% endif %}

									{{ adr.codepostal }}
									{{ adr.city }}<br>
									{{ adr.country }}<br>

									{% if adr.phone %}<br>{{ 'order.phone'|trans({}, 'emails', locale)|raw }}
										{{ adr.phone }}
									{% endif %}
								</address>
							{% else %}
								<p style="color: #666;">{{ 'order.no_address'|trans({}, 'emails', locale)|raw }}</p>
							{% endif %}
							{# --------------------------------- #}

						</td>
					</tr>
				</table>
			</td>
		</tr>
	</table>
{% endblock %}
