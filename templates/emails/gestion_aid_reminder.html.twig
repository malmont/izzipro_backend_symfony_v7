{% extends 'base.email.html.twig' %}

{# Gestion, lot FIS-2 : rappel des aides (conditions échues encore à faire, aides reçues sans justificatif). Un seul lien, vers l'écran des aides.
   `siteLine`, jamais `signature` : l'envoi commun remplace `signature` par celle de la configuration d'envoi du site. #}
{% block title %}{{ title }}{% endblock %}

{% block body %}
<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; color: #2d3748; background-color: #f7fafc; padding: 25px 0;">
    <tr>
        <td align="center">
            <table width="600" border="0" cellspacing="0" cellpadding="0" style="background-color: #ffffff; border-radius: 12px; overflow: hidden;">
                <tr>
                    <td align="center" style="background: #1e293b; padding: 28px 20px;">
                        <h1 style="color: #ffffff; margin: 0; font-size: 20px; font-weight: 700;">{{ title }}</h1>
                    </td>
                </tr>
                <tr>
                    <td style="padding: 30px; font-size: 15px; color: #1e293b;">
                        <p style="margin-top: 0;">{{ greeting }}</p>
                        <p>{{ message }}</p>
                        <ul style="font-size: 14px; background: #f8fafc; border-radius: 8px; margin: 20px 0; padding: 12px 12px 12px 30px;">
                            {% for row in rows %}<li style="margin: 4px 0;">{{ row }}</li>{% endfor %}
                        </ul>
                        {% if more %}<p style="color: #64748b; font-size: 14px;">{{ more }}</p>{% endif %}
                        <p>{{ nextStep }}</p>
                        {% if linkUrl is defined and linkUrl %}<p style="margin: 22px 0;"><a href="{{ linkUrl }}" style="display: inline-block; padding: 10px 18px; background: #1e293b; color: #ffffff; border-radius: 8px; text-decoration: none; font-weight: 600;">{{ linkLabel }}</a></p>{% endif %}
                        <p style="color: #64748b; font-size: 13px;">{{ notice }}</p>
                        <p style="color: #64748b; font-size: 13px; margin-bottom: 0;">{{ siteLine }}</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
{% endblock %}
