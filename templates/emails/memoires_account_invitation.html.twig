{# Invitation à activer un compte Mémoires Vivantes (UserManagementController). Variables ajoutées par EmailSenderService : fromName, signature, logoUrl, domain #}
<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8"><title>Activez votre compte</title></head>
<body style="margin:0;padding:0;background:#f4f1ea;font-family:Georgia,'Times New Roman',serif;color:#2c2c2c;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f4f1ea;padding:32px 12px;">
    <tr><td align="center">
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" style="max-width:600px;background:#ffffff;border-radius:8px;padding:36px 40px;">
            {% if logoUrl %}
                <tr><td align="center" style="padding-bottom:24px;"><img src="{{ logoUrl }}" alt="{{ fromName }}" style="max-height:60px;"></td></tr>
            {% endif %}
            <tr><td style="font-size:22px;color:#1f2d34;padding-bottom:16px;">Bonjour {{ firstName }},</td></tr>
            <tr><td style="font-size:15px;line-height:1.7;padding-bottom:20px;">
                {{ invitedBy }} vous invite à rejoindre <strong>{{ fromName }}</strong> pour écrire, chapitre après chapitre, un livre de souvenirs.
                Choisissez votre mot de passe en cliquant sur le bouton ci-dessous.
            </td></tr>
            <tr><td align="center" style="padding:8px 0 28px 0;">
                <a href="{{ activationUrl }}" style="display:inline-block;background:#b59449;color:#ffffff;text-decoration:none;padding:14px 32px;border-radius:4px;font-size:15px;letter-spacing:1px;">Activer mon compte</a>
            </td></tr>
            <tr><td style="font-size:13px;line-height:1.6;color:#666666;padding-bottom:20px;">
                Si le bouton ne fonctionne pas, copiez cette adresse dans votre navigateur :<br>
                <a href="{{ activationUrl }}" style="color:#b59449;word-break:break-all;">{{ activationUrl }}</a>
            </td></tr>
            <tr><td style="font-size:13px;line-height:1.6;color:#666666;">Votre identifiant de connexion est votre adresse e-mail : {{ email }}.</td></tr>
            {% if signature %}
                <tr><td style="font-size:13px;line-height:1.6;color:#666666;padding-top:24px;border-top:1px solid #eeeeee;">{{ signature|raw }}</td></tr>
            {% endif %}
        </table>
    </td></tr>
</table>
</body>
</html>
