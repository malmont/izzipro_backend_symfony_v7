{% extends 'base.email.html.twig' %}

{% block title %}Nouvelle demande de financement - Caravan201{% endblock %}

{% block body %}
    <table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: Arial, sans-serif; line-height: 1.6;">
        <tr>
            <td align="center" style="padding: 20px;">
                <table width="600" border="0" cellspacing="0" cellpadding="20" style="border: 1px solid #ddd; border-radius: 8px;">
                    {% if logoUrl is defined and logoUrl %}
                        <tr>
                            <td align="center" style="padding-bottom: 20px; border-bottom: 1px solid #eee;">
                                <img src="{{ logoUrl }}" alt="{{ fromName }}" style="max-width: 200px;">
                            </td>
                        </tr>
                    {% elseif fromName is defined %}
                        <tr>
                            <td align="center" style="padding-bottom: 20px; border-bottom: 1px solid #eee;">
                                <h1 style="margin:0;">{{ fromName }}</h1>
                            </td>
                        </tr>
                    {% endif %}

                    <tr>
                        <td style="padding: 30px;">
                            <h2 style="color: #333; margin-top: 0;">Demande de Financement & Crédit</h2>
                            <p>Une nouvelle demande de financement a été soumise sur votre site web.</p>

                            <h3 style="margin-top: 20px; border-bottom: 2px solid #eee; padding-bottom: 5px; color: #333;">Informations Personnelles</h3>
                            <table width="100%" border="0" cellspacing="0" cellpadding="10" style="background-color: #f9f9f9; border-radius: 5px;">
                                <tr>
                                    <td width="180" style="font-weight: bold; color: #666;">Nom complet :</td>
                                    <td style="color: #333;">{{ data.firstName }} {{ data.lastName }}</td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold; color: #666;">Courriel :</td>
                                    <td style="color: #333;"><a href="mailto:{{ data.email }}" style="color: #007bff; text-decoration: none;">{{ data.email }}</a></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold; color: #666;">Téléphone :</td>
                                    <td style="color: #333;">{{ data.phone }}</td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold; color: #666;">Date de naissance :</td>
                                    <td style="color: #333;">{{ data.birthDate }}</td>
                                </tr>
                            </table>

                            <h3 style="margin-top: 25px; border-bottom: 2px solid #eee; padding-bottom: 5px; color: #333;">Véhicule Recherché</h3>
                            <table width="100%" border="0" cellspacing="0" cellpadding="10" style="background-color: #f9f9f9; border-radius: 5px;">
                                <tr>
                                    <td width="180" style="font-weight: bold; color: #666;">Type de véhicule :</td>
                                    <td style="color: #333;">{{ data.vehicleType }}</td>
                                </tr>
                            </table>

                            <h3 style="margin-top: 25px; border-bottom: 2px solid #eee; padding-bottom: 5px; color: #333;">Adresse & Habitation</h3>
                            <table width="100%" border="0" cellspacing="0" cellpadding="10" style="background-color: #f9f9f9; border-radius: 5px;">
                                <tr>
                                    <td width="180" style="font-weight: bold; color: #666;">Adresse complète :</td>
                                    <td style="color: #333;">{{ data.address }}</td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold; color: #666;">Durée au domicile :</td>
                                    <td style="color: #333;">{{ data.timeAtResidence }}</td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold; color: #666;">Statut résidentiel :</td>
                                    <td style="color: #333;">{{ data.housingStatus }}</td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold; color: #666;">Paiement mensuel :</td>
                                    <td style="color: #333;">{{ data.monthlyPayment }} $ / mois</td>
                                </tr>
                            </table>

                            <h3 style="margin-top: 25px; border-bottom: 2px solid #eee; padding-bottom: 5px; color: #333;">Détails Financiers</h3>
                            <table width="100%" border="0" cellspacing="0" cellpadding="10" style="background-color: #f9f9f9; border-radius: 5px;">
                                <tr>
                                    <td width="180" style="font-weight: bold; color: #666;">Cote de crédit :</td>
                                    <td style="color: #333;">{{ data.creditScore }}</td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold; color: #666;">Revenu mensuel brut :</td>
                                    <td style="color: #333;">{{ data.monthlyIncome }} $ / mois</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
{% endblock %}
