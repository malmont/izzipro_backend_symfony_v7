{% extends 'base.email.html.twig' %}

{% block title %}Règlement de votre livre « {{ book.title }} »{% endblock %}

{% block body %}
<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; color: #2d3748; background-color: #f7fafc; padding: 25px 0;">
    <tr>
        <td align="center">
            <table width="600" border="0" cellspacing="0" cellpadding="0" style="background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);">
                
                <!-- HEADER -->
                <tr>
                    <td align="center" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); padding: 35px 20px;">
                        {% if logoCid is defined and logoCid %}
                            <img src="cid:{{ logoCid }}" alt="{{ fromName }}" style="max-height: 55px; max-width: 240px; margin-bottom: 12px; display: inline-block; border: 0;">
                        {% elseif logoUrl is defined and logoUrl %}
                            <img src="{{ logoUrl }}" alt="{{ fromName }}" style="max-height: 55px; max-width: 240px; margin-bottom: 12px; display: inline-block; border: 0;">
                        {% else %}
                            <h1 style="color: #ffffff; margin: 0; font-size: 24px; font-weight: 700; letter-spacing: 0.5px;">{{ fromName }}</h1>
                        {% endif %}
                        <p style="color: #cbd5e1; margin: 8px 0 0 0; font-size: 14px;">Vos souvenirs méritent un écrin exceptionnel</p>
                    </td>
                </tr>

                <!-- CONTENU -->
                <tr>
                    <td style="padding: 35px 30px;">
                        <h2 style="color: #0f172a; margin-top: 0; font-size: 20px;">Bonjour,</h2>
                        <p style="font-size: 15px; color: #475569; margin-bottom: 25px;">
                            Votre livre personnalisé <strong>« {{ book.title }} »</strong> est prêt pour impression et reliure.
                        </p>

                        {% if customMessage %}
                            <div style="background-color: #f8fafc; border-left: 4px solid #3b82f6; padding: 14px 18px; border-radius: 6px; margin-bottom: 25px; font-style: italic; color: #334155;">
                                {{ customMessage|nl2br }}
                            </div>
                        {% endif %}

                        <!-- RÉCAPITULATIF COMMANDE -->
                        <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 20px; margin-bottom: 30px;">
                            <h3 style="margin: 0 0 15px 0; font-size: 16px; color: #1e293b; border-bottom: 1px solid #e2e8f0; padding-bottom: 10px;">
                                📖 Détails de votre commande
                            </h3>
                            <table width="100%" border="0" cellspacing="0" cellpadding="6" style="font-size: 14px;">
                                <tr>
                                    <td style="color: #64748b;">Titre de l'ouvrage :</td>
                                    <td align="right" style="font-weight: 600; color: #0f172a;">{{ book.title|raw }}</td>
                                </tr>
                                {% if book.subtitle %}
                                <tr>
                                    <td style="color: #64748b;">Sous-titre :</td>
                                    <td align="right" style="color: #334155;">{{ book.subtitle|raw }}</td>
                                </tr>
                                {% endif %}
                                <tr>
                                    <td style="color: #64748b;">Format :</td>
                                    <td align="right" style="color: #334155; text-transform: uppercase;">{{ book.format }}</td>
                                </tr>
                                <tr style="border-top: 1px solid #cbd5e1;">
                                    <td style="padding-top: 12px; font-size: 16px; font-weight: 700; color: #0f172a;">Montant total :</td>
                                    <td align="right" style="padding-top: 12px; font-size: 18px; font-weight: 800; color: #16a34a;">
                                        {{ amount|number_format(2, ',', ' ') }} {{ currencySymbol }}
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- BOUTON DE PAIEMENT STRIPE -->
                        <table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-bottom: 30px;">
                            <tr>
                                <td align="center">
                                    <a href="{{ paymentLinkUrl }}" target="_blank" style="display: inline-block; background-color: #2563eb; color: #ffffff; text-decoration: none; font-size: 16px; font-weight: 700; padding: 16px 36px; border-radius: 8px; box-shadow: 0 4px 6px rgba(37, 99, 235, 0.25);">
                                        💳 Régler ma commande en ligne
                                    </a>
                                </td>
                            </tr>
                        </table>

                        <p style="font-size: 12px; color: #94a3b8; text-align: center; margin: 0 0 20px 0;">
                            🔒 Paiement 100% sécurisé via Stripe. Vos coordonnées bancaires sont chiffrées de bout en bout.
                        </p>

                        <div style="border-top: 1px solid #f1f5f9; padding-top: 15px; font-size: 12px; color: #94a3b8;">
                            Si le bouton ci-dessus ne fonctionne pas, copiez et collez l'adresse suivante dans votre navigateur :<br>
                            <a href="{{ paymentLinkUrl }}" style="color: #2563eb; word-break: break-all;">{{ paymentLinkUrl }}</a>
                        </div>
                    </td>
                </tr>

                <!-- FOOTER -->
                <tr>
                    <td align="center" style="background-color: #f8fafc; padding: 20px; border-top: 1px solid #e2e8f0; font-size: 12px; color: #64748b;">
                        {{ fromName }} — Tous droits réservés.
                    </td>
                </tr>

            </table>
        </td>
    </tr>
</table>
{% endblock %}
