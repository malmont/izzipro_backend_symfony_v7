{% extends 'base.email.html.twig' %}

{# Import d'une boutique existante, lot IMP-2 (15/11/2026) : invitation d'un client repris du fichier des clients de l'ancienne boutique.
   Un seul courriel, sobre, sans aucune promotion. Deux liens vers la page de la boutique publique : rouvrir le compte (mot de passe et
   conditions), ou faire effacer tout de suite ce qui a été repris. La dernière ligne est `siteLine` : l'envoi commun écrase
   `signature` par celle de la configuration d'envoi du site. #}
{% block title %}{{ title }}{% endblock %}

{% block body %}
<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
    <tr><td align="center">
        <table width="600" border="0" cellspacing="0" cellpadding="0" style="background-color: #ffffff; border-radius: 12px; overflow: hidden;">
            <tr><td style="padding: 28px 32px; color: #1e293b; font-size: 15px; line-height: 1.6;">
                <p>{{ greeting }}</p>
                <p>{{ message }}</p>
                <p style="text-align: center; margin: 28px 0 8px 0;"><a href="{{ link }}" style="display: inline-block; background: #1e293b; color: #ffffff; text-decoration: none; padding: 14px 28px; border-radius: 8px; font-weight: 600;">{{ button }}</a></p>
                <p style="text-align: center; color: #64748b; font-size: 13px; margin: 0 0 24px 0;">{{ afterButton }}</p>
                <p style="color: #64748b; font-size: 13px;">{{ validity }}</p>
                <p style="color: #64748b; font-size: 13px;">{{ declineIntro }} <a href="{{ declineLink }}" style="color: #1e293b;">{{ declineLabel }}</a>.</p>
                <p style="color: #64748b; font-size: 13px;">{{ once }}</p>
                <p style="color: #64748b; font-size: 13px; margin-bottom: 0;">{{ siteLine }}</p>
            </td></tr>
        </table>
    </td></tr>
</table>
{% endblock %}
