{% extends 'base.email.html.twig' %}

{# Avis au propriétaire du livre (08/11/2026) : les renouvellements automatiques d'une invitation sont épuisés sans réponse complète #}
{% block title %}{{ 'chapter_invitation.exhausted_subject'|trans({'%chapter%': chapterTitle|e}, 'emails', locale)|raw }}{% endblock %}

{% block body %}
<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
    <tr>
        <td align="center">
            <table width="600" border="0" cellspacing="0" cellpadding="0" style="background-color: #ffffff; border-radius: 12px; overflow: hidden;">
                <tr>
                    <td align="center" style="background: #1e293b; padding: 28px 20px;">
                        <h1 style="color: #ffffff; margin: 0; font-size: 20px; font-weight: 700;">{{ 'chapter_invitation.exhausted_title'|trans({}, 'emails', locale)|raw }}</h1>
                    </td>
                </tr>
                <tr>
                    <td style="padding: 30px; font-size: 15px; color: #1e293b; line-height: 1.55;">
                        <p style="margin-top: 0;">
                            {% if ownerFirstName is not empty %}{{ 'chapter_invitation.greeting'|trans({'%name%': ownerFirstName|e}, 'emails', locale)|raw }}{% else %}{{ 'chapter_invitation.greeting_anonymous'|trans({}, 'emails', locale)|raw }}{% endif %}
                        </p>
                        <p>{{ 'chapter_invitation.exhausted_body'|trans({'%email%': email|e, '%name%': firstName is not empty ? ' (' ~ firstName|e ~ ')' : '', '%chapter%': chapterTitle|e, '%book%': bookTitle|e, '%count%': count}, 'emails', locale)|raw }}</p>
                        <p>{{ 'chapter_invitation.exhausted_action'|trans({}, 'emails', locale)|raw }}</p>
                        <p style="text-align: center; margin: 28px 0 0;">
                            <a href="{{ bookUrl }}" style="display: inline-block; background: #1e293b; color: #ffffff; text-decoration: none; padding: 12px 24px; border-radius: 8px; font-weight: 600;">{{ 'chapter_invitation.exhausted_button'|trans({}, 'emails', locale)|raw }}</a>
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
{% endblock %}
