{% extends 'base.email.html.twig' %}

{% block title %}Nouvelle commande à expédier - n°{{ order.reference }}{% endblock %}

{% block body %}
<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: Arial, sans-serif; line-height: 1.6;">
    <tr>
        <td align="center" style="padding: 20px;">
            <table width="600" border="0" cellspacing="0" cellpadding="20" style="border: 1px solid #ddd; border-radius: 8px;">
                
                <!-- 1. En-tête (Logo / Nom) -->
                {% if logoUrl is defined and logoUrl %}
                    <tr>
                        <td align="center" style="padding-bottom: 20px; border-bottom: 1px solid #eee;">
                            <img src="{{ domain ~ logoUrl }}" alt="{{ fromName }}" style="max-width: 200px;">
                        </td>
                    </tr>
                {% elseif fromName is defined %}
                    <tr>
                        <td align="center" style="padding-bottom: 20px; border-bottom: 1px solid #eee;">
                            <h1 style="margin:0;">{{ fromName }}</h1>
                        </td>
                    </tr>
                {% endif %}

                <!-- 2. Contenu de l'email -->
                <tr>
                    <td style="padding: 30px;">
                        <h1 style="color: #d9534f;">Nouvelle commande à préparer</h1>
                
                        <p>Une nouvelle commande (n°<strong>{{ order.reference }}</strong>) doit être expédiée.</p>
                        <p>
                            <strong>Client :</strong> {{ order.userId.firstname }} {{ order.userId.lastname }}<br>
                            <strong>Email :</strong> {{ order.userId.email }}
                        </p>

                        <h2 style="margin-top: 30px; border-bottom: 2px solid #eee; padding-bottom: 5px;">Étiquettes d'expédition</h2>
                        
                        {% if labels is not empty %}
                            <p>Les étiquettes suivantes ont été générées :</p>
                            <ul style="list-style-type: none; padding-left: 0;">
                                {% for label in labels %}
                                    <li style="border: 1px solid #eee; padding: 15px; margin-bottom: 10px; border-radius: 5px;">
                                        <strong>Tracking :</strong> {{ label.trackingCode }}<br>
                                        <strong>URL Étiquette :</strong> <a href="{{ label.labelUrl }}" target="_blank">Voir/Télécharger l'étiquette</a>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <p style="font-weight: bold; color: #d9534f; border: 1px solid #d9534f; padding: 15px; border-radius: 5px;">
                                ATTENTION : Aucune étiquette n'a été générée automatiquement pour cette commande.
                            </p>
                        {% endif %}

                        <h2 style="margin-top: 30px; border-bottom: 2px solid #eee; padding-bottom: 5px;">Adresse de livraison</h2>
                        
                        {% set adr = order.shippingAdress %}
                        {% if adr %}
                        

                        <address style="font-style: normal; line-height: 1.5; background-color: #f9f9f9; padding: 15px; border-radius: 5px;">
                            <strong>{{ adr.fullname }}</strong><br>
                            {% if adr.company %}{{ adr.company }}<br>{% endif %}
                            {{ adr.address }}<br>
                            {% if adr.complement %}{{ adr.complement }}<br>{% endif %}
                            {{ adr.codepostal }} {{ adr.city }}<br>
                            {% if adr.province %}{{ adr.province }}<br>{% endif %}
                            {{ adr.country }}<br>
                            {% if adr.phone %}Tél : {{ adr.phone }}{% endif %}
                        </address>
                        
                        {% else %}
                        <p>Aucune adresse de livraison n'a été fournie pour cette commande.</p>
                        {% endif %}
                    </td>
                </tr>

                <!-- 3. Signature (Pied de page) -->
                {% if signature is defined and signature %}
                    <tr>
                        <td align="center" style="padding: 20px; border-top: 1px solid #eee; font-size: 12px; color: #888;">
                            <p style="margin:0;">{{ signature|raw }}</p>
                        </td>
                    </tr>
                {% endif %}
                
            </table>
        </td>
    </tr>
</table>
{% endblock %}