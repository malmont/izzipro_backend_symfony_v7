{% extends 'base.email.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{# Lot ABO-LANG (21/11/2026) : dans la langue de l'abonné (`locale`, posé par SubscriptionMailer), textes `subscription_notice.*` #}
{% block body %}
<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; color: #2d3748; background-color: #f7fafc; padding: 25px 0;">
    <tr>
        <td align="center">
            <table width="600" border="0" cellspacing="0" cellpadding="0" style="background-color: #ffffff; border-radius: 12px; overflow: hidden;">
                <tr>
                    <td align="center" style="background: #1e293b; padding: 28px 20px;">
                        <h1 style="color: #ffffff; margin: 0; font-size: 20px; font-weight: 700;">{{ title }}</h1>
                    </td>
                </tr>
                <tr>
                    <td style="padding: 30px; font-size: 15px; color: #1e293b;">
                        <p style="margin-top: 0;">{{ 'subscription_notice.greeting'|trans({'%name%': subscription.user.firstname|default('')}, 'emails', locale) }}</p>
                        <p>{{ message }}</p>
                        <table width="100%" border="0" cellspacing="0" cellpadding="6" style="font-size: 14px; background: #f8fafc; border-radius: 8px; margin: 20px 0;">
                            <tr><td style="color: #64748b;">{{ 'subscription_notice.row.plan'|trans({}, 'emails', locale) }}</td><td align="right" style="font-weight: 600;">{{ planName }}</td></tr>
                            <tr><td style="color: #64748b;">{{ 'subscription_notice.row.quantity'|trans({}, 'emails', locale) }}</td><td align="right">{{ subscription.quantity }}</td></tr>
                            <tr><td style="color: #64748b;">{{ 'subscription_notice.row.status'|trans({}, 'emails', locale) }}</td><td align="right">{{ subscription.status }}</td></tr>
                            {% if subscription.currentPeriodEnd %}<tr><td style="color: #64748b;">{{ 'subscription_notice.row.period_end'|trans({}, 'emails', locale) }}</td><td align="right">{{ subscription.currentPeriodEnd|date('d/m/Y') }}</td></tr>{% endif %}
                            {% for label, value in rows|default([]) %}<tr><td style="color: #64748b;">{{ label }}</td><td align="right" style="font-weight: 600;">{{ value }}</td></tr>{% endfor %}
                        </table>
                        {% if payUrl|default(null) %}
                        <p style="text-align: center; margin: 24px 0;"><a href="{{ payUrl }}" style="background: #1e293b; color: #ffffff; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: 600;">{{ 'subscription_notice.pay_now'|trans({}, 'emails', locale) }}</a></p>
                        {% endif %}
                        <p style="color: #64748b; font-size: 13px;">{{ 'subscription_notice.manage'|trans({}, 'emails', locale) }}</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
{% endblock %}
