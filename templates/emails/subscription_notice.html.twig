{% extends 'base.email.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; color: #2d3748; background-color: #f7fafc; padding: 25px 0;">
    <tr>
        <td align="center">
            <table width="600" border="0" cellspacing="0" cellpadding="0" style="background-color: #ffffff; border-radius: 12px; overflow: hidden;">
                <tr>
                    <td align="center" style="background: #1e293b; padding: 28px 20px;">
                        <h1 style="color: #ffffff; margin: 0; font-size: 20px; font-weight: 700;">{{ title }}</h1>
                    </td>
                </tr>
                <tr>
                    <td style="padding: 30px; font-size: 15px; color: #1e293b;">
                        <p style="margin-top: 0;">Bonjour {{ subscription.user.firstname|default('') }},</p>
                        <p>{{ message }}</p>
                        <table width="100%" border="0" cellspacing="0" cellpadding="6" style="font-size: 14px; background: #f8fafc; border-radius: 8px; margin: 20px 0;">
                            <tr><td style="color: #64748b;">Formule</td><td align="right" style="font-weight: 600;">{{ subscription.plan.getName(app.request ? app.request.locale : 'fr') }}</td></tr>
                            <tr><td style="color: #64748b;">Quantité</td><td align="right">{{ subscription.quantity }}</td></tr>
                            <tr><td style="color: #64748b;">Statut</td><td align="right">{{ subscription.status }}</td></tr>
                            {% if subscription.currentPeriodEnd %}<tr><td style="color: #64748b;">Fin de la période</td><td align="right">{{ subscription.currentPeriodEnd|date('d/m/Y') }}</td></tr>{% endif %}
                        </table>
                        <p style="color: #64748b; font-size: 13px;">Gérez votre abonnement depuis votre compte sur le site.</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
{% endblock %}
