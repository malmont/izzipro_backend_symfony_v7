{# Page publique d'un reçu (F3) : atteinte par le lien du QR code. Non indexée, sans cache. #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ title }}</title>
    <style>body{margin:0;padding:16px;background:#f4f4f4;}.card{background:#fff;border-radius:8px;padding:16px;box-shadow:0 1px 3px rgba(0,0,0,.1);max-width:420px;margin:0 auto;}.actions{text-align:center;margin:12px auto;max-width:420px;font-size:13px;}a{color:{{ profile.primaryColor ?? '#1f2d34' }};}</style>
</head>
<body>
{% if receipt is defined %}
    <div class="card">{{ include('pos/_receipt_body.html.twig') }}</div>
    <div class="actions"><a href="?format=pdf">Télécharger en PDF</a></div>
{% else %}
    <div class="card" style="text-align:center;"><h2 style="font-size:16px;">{{ title }}</h2><p>{{ message }}</p></div>
{% endif %}
</body>
</html>
