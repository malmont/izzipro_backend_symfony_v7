<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion · Arkanoa Media</title>
    <link rel="icon" type="image/png" href="{{ asset('assets/arkanoa-favicon.png') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Michroma&family=Outfit:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="{{ asset('assets/css/login.css') }}?v=20260925-v2">
    <style>
        .input-icon { width: 18px !important; height: 18px !important; max-width: 18px !important; max-height: 18px !important; }
        .btn-connexion svg { width: 18px !important; height: 18px !important; max-width: 18px !important; }
    </style>
</head>
<body>
<div class="login-page-wrapper">
    <div class="login-bg" aria-hidden="true">
        <span class="login-glow login-glow--blue"></span>
        <span class="login-glow login-glow--magenta"></span>
        <svg class="login-facets" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
            <path d="M-40 780 L420 60 L560 60" />
            <path d="M1480 120 L980 900" />
            <path d="M760 900 L1100 380 L1480 380" />
            <path d="M0 300 L300 300 L520 -20" />
        </svg>
    </div>

    <div class="login-container">
        <div class="login-logo">
            <img src="{{ asset('assets/logo-arkanoa-media.png') }}" alt="Arkanoa Media">
        </div>

        <div class="login-eyebrow">Studio Digital · Espace Authentification</div>

        {% if error %}
            <div class="alert alert-danger" role="alert">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" autocomplete="on">
            <div class="form-group">
                <label for="inputEmail">Identifiant ou Courriel</label>
                <div class="input-with-icon">
                    <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    <input type="text" id="inputEmail" name="email" value="{{ last_username }}" class="form-control" placeholder="nom@exemple.com" required autofocus autocomplete="username">
                </div>
            </div>

            <div class="form-group">
                <div class="form-label-row">
                    <label for="inputPassword">Mot de passe</label>
                </div>
                <div class="input-with-icon">
                    <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    <input type="password" id="inputPassword" name="password" class="form-control" placeholder="••••••••" required autocomplete="current-password">
                </div>
            </div>

            <div class="form-group">
                <label for="selectLang">Langue</label>
                <select id="selectLang" class="form-control">
                    <option selected>Français (Canada)</option>
                    <option>English</option>
                </select>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="form-group" style="margin-top: 26px;">
                <button class="btn-connexion" type="submit">
                    <span>CONNEXION</span>
                    <svg viewBox="0 0 20 20" aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h11M11 5l5 5-5 5"/></svg>
                </button>
            </div>
        </form>

        <div class="login-links">
            <a href="https://arkanoa-media.com" target="_blank" rel="noopener" class="btn-secondary-link">Visiter le site Arkanoa Media</a>
            <a href="mailto:contact@arkanoa-media.com" class="btn-secondary-link">Support & Assistance technique</a>
        </div>
    </div>

    <div class="login-footer-credits">
        © {{ "now"|date("Y") }} Arkanoa Media LLC. Tous droits réservés.
    </div>
</div>
</body>
</html>