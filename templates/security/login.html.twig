{% extends 'base.html.twig' %}

{% block title %}Connexion - GEM-WORK{% endblock %}

{# Ajout d'un block pour les styles spécifiques à cette page #}
{% block stylesheets %}
    {{ parent() }} {# Conserve les styles de base.html.twig si nécessaire #}
    <link rel="stylesheet" href="{{ asset('assets/css/login.css') }}">
{% endblock %}

{% block body %}
<div class="login-page-wrapper">

    <div class="login-container">
        <div class="login-logo">
            {# Utilisation de la fonction asset() pour le chemin du logo #}
            <img src="{{ asset('assets/Logo-Principal_GEM-PORTAL.png') }}"
               alt="GEM-PORTAL">
        </div>

        {# Affichage des erreurs de connexion, s'il y en a #}
        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post">
            <div class="form-group">
                {# MODIFIÉ : de "_username" à "email" pour correspondre à l'ancienne logique #}
                <input type="text" name="email" value="{{ last_username }}" class="form-control" placeholder="Code d'utilisateur ou Courriel" required autofocus>
            </div>

            <div class="form-group">
                {# MODIFIÉ : de "_password" à "password" pour correspondre à l'ancienne logique #}
                <input type="password" name="password" class="form-control" placeholder="Mot de passe" required>
            </div>
            
            <div class="form-group">
                 <select class="form-control">
                    <option selected>Français</option>
                    <option>English</option>
                </select>
            </div>

            {# Jeton CSRF pour la sécurité #}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="form-group">
                <button class="btn-connexion" type="submit">CONNEXION</button>
            </div>
        </form>
        
        <div class="login-links">
            <a href="#" class="btn-secondary-link">MOT DE PASSE OUBLIÉ</a>
            <a href="#" class="btn-secondary-link">POLITIQUE DE PROTECTION DES RENSEIGNEMENTS</a>
            <a href="#" class="btn-secondary-link">TERMES ET CONDITIONS</a>
        </div>

    </div>
</div>
{% endblock %}