{% extends 'base.email.html.twig' %}

{# Langue du client (03/11/2026) : `locale` (fr|en) et textes du domaine `emails` ; le français reste identique à avant #}
{% block title %}{{ 'otp.title'|trans({}, 'emails', locale)|raw }}{% endblock %}

{% block body %}
  <div style="text-align: center; margin-bottom: 20px;">
    {% if logoUrl %}
      {# logoUrl est complet : image intégrée (cid:) ou adresse absolue ; le préfixer du domaine cassait l'image (09/10/2026) #}
      <img src="{{ logoUrl }}" alt="{{ fromName }} Logo" style="max-width: 200px;">
    {% endif %}
    {% if fromName %}
      <h1>{{ fromName }}</h1>
    {% endif %}
  </div>
  <p>
    {{ 'otp.greeting'|trans({}, 'emails', locale)|raw }}<br>
    {{ 'otp.code_is'|trans({}, 'emails', locale)|raw }} <strong>{{ code }}</strong>.<br>
    {{ 'otp.expires'|trans({'%minutes%': (lifetime / 60)|round}, 'emails', locale)|raw }}
  </p>
  
  {% if signature %}
    <p>{{ signature|raw }}</p>
  {% elseif entreprise %}
    <p>
      {{ 'otp.contact'|trans({}, 'emails', locale)|raw }}<br>
      {{ 'otp.email_label'|trans({}, 'emails', locale)|raw }} {{ entreprise.email }}<br>
      {{ 'otp.phone_label'|trans({}, 'emails', locale)|raw }} {{ entreprise.tel }}
    </p>
  {% endif %}
{% endblock %}