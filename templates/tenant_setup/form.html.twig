<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configuration Boutique · Arkanoa Media</title>
    <link rel="icon" type="image/png" href="{{ asset('assets/arkanoa-favicon.png') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Michroma&family=Outfit:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="{{ asset('assets/css/setup.css') }}?v=20260925-v2">
</head>
<body>
<div class="setup-page-wrapper">
    <div class="setup-bg" aria-hidden="true">
        <span class="setup-glow setup-glow--blue"></span>
        <span class="setup-glow setup-glow--magenta"></span>
    </div>

    <div class="setup-container">
        <div class="setup-logo">
            <img src="{{ asset('assets/logo-arkanoa-media.png') }}" alt="Arkanoa Media Logo">
        </div>

        <div class="setup-eyebrow">Studio Digital · Déploiement Cloud</div>

        <h1>Finaliser la Création de Votre Boutique</h1>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% if not form.vars.valid %}
            <div class="alert alert-danger">
                <strong>Attention :</strong>
                <ul style="margin: 8px 0 0 16px; padding: 0;">
                    {% for error in form.vars.errors %}
                        <li>{{ error.message }}</li>
                    {% endfor %}
                    {% for child in form.children %}
                        {% for error in child.vars.errors %}
                            <li><strong>{{ child.vars.label|default(child.vars.name) }} :</strong> {{ error.message }}</li>
                        {% endfor %}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {{ form_start(form) }}
        
            <div class="form-section">
                <h2>Votre Site</h2>
                <div class="form-row">
                    {{ form_row(form.subdomain_display) }}
                </div>
            </div>

            <div class="form-section">
                <h2>Sécurité & Autorisation</h2>
                <div class="form-row">
                    {{ form_row(form.secretKey) }}
                </div>
            </div>

            <div class="form-section">
                <h2>Informations de l'Entreprise</h2>
                <div class="form-row">
                    {{ form_row(form.companyName) }}
                    {{ form_row(form.companyEmail) }}
                </div>
                <div class="form-row">
                    {{ form_row(form.companyPhone) }}
                    {{ form_row(form.companyWebsite) }}
                </div>
                <div class="form-row">
                    {{ form_row(form.companyEin) }}
                    {{ form_row(form.companyTva) }}
                </div>
            </div>

            <div class="form-section">
                <h2>Adresse de l'Entreprise</h2>
                <div class="form-row">
                    {{ form_row(form.street1) }}
                    {{ form_row(form.street2) }}
                </div>
                <div class="form-row">
                    {{ form_row(form.city) }}
                    {{ form_row(form.zip) }}
                </div>
                <div class="form-row">
                    {{ form_row(form.state) }}
                    {{ form_row(form.country) }}
                </div>
            </div>

            <div class="form-row">
                 {{ form_widget(form.save, {'attr': {'class': 'btn-submit'}}) }}
            </div>

            {{ form_rest(form) }}

        {{ form_end(form) }}
    </div>
</div>
</body>
</html>