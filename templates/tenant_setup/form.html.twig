{# templates/tenant_setup/form.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Finaliser la création de votre site{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/setup.css') }}">
{% endblock %}

{% block body %}
<div class="setup-page-wrapper">
    <div class="setup-container">

        <div class="setup-logo">
            <img src="{{ asset('assets/Logo-Principal_GEM-PORTAL.png') }}" alt="GEM-PORTAL Logo">
        </div>

        <h1>Finaliser la Création de Votre Site</h1>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {{ form_start(form) }}
        
            <div class="form-section">
                <h2>Votre Site</h2>
                <div class="form-row">
                    {{ form_row(form.subdomain_display) }}
                </div>
            </div>

            <div class="form-section">
                <h2>Sécurité & Autorisation</h2>
                <div class="form-row">
                    {{ form_row(form.secretKey) }}
                </div>
            </div>

            <div class="form-section">
                <h2>Informations de l'Entreprise</h2>
                <div class="form-row">
                    {{ form_row(form.companyName) }}
                    {{ form_row(form.companyEmail) }}
                </div>
                <div class="form-row">
                    {{ form_row(form.companyPhone) }}
                    {{ form_row(form.companyWebsite) }}
                </div>
                <div class="form-row">
                    {{ form_row(form.companyEin) }}
                    {{ form_row(form.companyTva) }}
                </div>
            </div>

            <div class="form-section">
                <h2>Adresse de l'Entreprise</h2>
                <div class="form-row">
                    {{ form_row(form.street1) }}
                    {{ form_row(form.street2) }}
                </div>
                <div class="form-row">
                    {{ form_row(form.city) }}
                    {{ form_row(form.zip) }}
                </div>
                <div class="form-row">
                    {{ form_row(form.state) }}
                    {{ form_row(form.country) }}
                </div>
            </div>

            <div class="form-row">
                 {{ form_widget(form.save, {'attr': {'class': 'btn-submit'}}) }}
            </div>

            {{ form_rest(form) }}

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}