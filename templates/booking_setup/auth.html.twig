{% extends 'base.html.twig' %}

{% block title %}Accès Configuration{% endblock %}

{% block body %}
<div class="container d-flex flex-column justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-lg p-5 border-0" style="max-width: 500px; width: 100%;">
        <div class="text-center mb-4">
            <h1 class="h3 fw-bold text-primary">Configuration Booking</h1>
            <p class="text-muted">Espace réservé : <span class="badge bg-secondary">{{ shopName }}</span></p>
        </div>

        {% for message in app.flashes('danger') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('info') %}
            <div class="alert alert-info">{{ message }}</div>
        {% endfor %}

        {{ form_start(form) }}
            {{ form_row(form.token) }}
            {{ form_row(form.submit) }}
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}