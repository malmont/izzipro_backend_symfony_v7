{# templates/sync_status/index.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}
    {% if status == 'completed' %}Site Prêt !{% else %}Création en cours...{% endif %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/setup.css') }}">
    {# On ajoute un peu de CSS inline juste pour la barre de progression si Bootstrap n'est pas complet #}
    <style>
        .progress-wrapper {
            margin: 2rem 0;
            background-color: #e9ecef;
            border-radius: 0.25rem;
            overflow: hidden;
            box-shadow: inset 0 1px 2px rgba(0,0,0,.1);
        }
        .progress-bar {
            display: flex;
            flex-direction: column;
            justify-content: center;
            color: #fff;
            text-align: center;
            white-space: nowrap;
            background-color: #0d6efd; /* Couleur principale GEM-PORTAL? */
            transition: width .6s ease;
            height: 30px;
            font-weight: bold;
        }
        .progress-bar.bg-success { background-color: #198754; }
        .status-icon { font-size: 4rem; margin-bottom: 1rem; display: block; text-align: center; }
        .text-center { text-align: center; }
        .text-success { color: #198754; }
        .text-danger { color: #dc3545; }
        .step-text { color: #6c757d; font-size: 1.1em; margin-bottom: 10px; display: block; text-align: center;}
    </style>
{% endblock %}

{% block body %}
<div class="setup-page-wrapper">
    <div class="setup-container">

        <div class="setup-logo">
            <img src="{{ asset('assets/Logo-Principal_GEM-PORTAL.png') }}" alt="GEM-PORTAL Logo">
        </div>

        {# --- ÉTAT 1 : EN COURS (Running / Pending) --- #}
        {% if status == 'running' or status == 'pending' %}
            
            {# Méta refresh pour recharger la page toutes les 2 secondes #}
            <meta http-equiv="refresh" content="2">

            <h1>Création de votre site en cours...</h1>
            
            <div class="form-section">
                <span class="step-text">{{ step }}</span>

                <div class="progress-wrapper">
                    <div class="progress-bar progress-bar-striped progress-bar-animated" 
                         role="progressbar" 
                         style="width: {{ percent|round }}%;" 
                         aria-valuenow="{{ percent|round }}" 
                         aria-valuemin="0" 
                         aria-valuemax="100">
                         {{ percent|round }}%
                    </div>
                </div>
                
                <p class="text-center" style="font-size: 0.9em; opacity: 0.7;">
                    Veuillez ne pas fermer cette page.<br>
                    Nous configurons votre base de données et importons vos produits.
                </p>
            </div>

        {# --- ÉTAT 2 : TERMINÉ (Completed) --- #}
        {% elseif status == 'completed' %}

            {# Redirection automatique vers le site final après 1 seconde #}
            <meta http-equiv="refresh" content="1;url={{ finalUrl }}">
            
            <div class="text-center">
                <div class="status-icon text-success">
                    <i class="fas fa-check-circle"></i> </div>
                
                <h1 class="text-success">Félicitations !</h1>
                
                <div class="form-section">
                    <p style="font-size: 1.2em;">Votre site <strong>{{ tenantCode }}</strong> est prêt.</p>
                    <p>Vous allez être redirigé automatiquement...</p>
                </div>

                <div class="form-row">
                    <a href="{{ finalUrl }}" class="btn-submit">Accéder à mon site</a>
                </div>
            </div>

        {# --- ÉTAT 3 : ÉCHEC (Failed) --- #}
        {% elseif status == 'failed' %}

            <div class="text-center">
                <div class="status-icon text-danger">
                    <i class="fas fa-times-circle"></i>
                </div>

                <h1 class="text-danger">Une erreur est survenue</h1>

                <div class="form-section">
                    <div class="alert alert-danger" style="text-align: left;">
                        <strong>Détails techniques :</strong><br>
                        {{ error|nl2br }}
                    </div>
                </div>

                <div class="form-row">
                    {# Retour à la page de setup pour réessayer #}
                    <a href="{{ path('app_tenant_setup') }}" class="btn-submit" style="background-color: #6c757d;">Retour au formulaire</a>
                </div>
            </div>

        {% endif %}

    </div>
</div>
{% endblock %}