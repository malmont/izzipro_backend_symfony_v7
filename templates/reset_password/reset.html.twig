{# templates/reset_password/reset.html.twig #}
{% extends 'base.email.html.twig' %}

{% block title %}Réinitialisation du mot de passe{% endblock %}

{% block body %}
<div class="container mt-5">
    {% if emailConfig and emailConfig.logo %}
        <div class="text-center mb-4">
            <img src="{{ domain ~ emailConfig.logo }}" alt="{{ emailConfig.fromName }}" style="max-width: 200px;">
        </div>
    {% endif %}
    {% if emailConfig and emailConfig.fromName %}
        <div class="text-center mb-4">
            <h2>{{ emailConfig.fromName }}</h2>
        </div>
    {% endif %}
    <div class="alert alert-info" role="alert">
        <h4 class="alert-heading">Bonjour, {{ user.firstname }}!</h4>
        <p>Vous avez demandé la réinitialisation de votre mot de passe.</p>
        <hr>
        <p class="mb-0">Cliquez sur le lien ci-dessous pour réinitialiser votre mot de passe :</p>
        <p class="mb-0"><a href="{{ resetUrl }}">Réinitialiser mon mot de passe</a></p>
        <p class="mt-3">Ce lien expirera dans 1 heure.</p>
    </div>
</div>
{% endblock %}
