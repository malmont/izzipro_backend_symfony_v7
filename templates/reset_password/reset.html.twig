{# templates/reset_password/reset.html.twig #}
{% extends 'base.email.html.twig' %}

{# Langue du client (03/11/2026) : `locale` (fr|en), domaine `emails` #}
{% block title %}{{ 'reset.title'|trans({}, 'emails', locale)|raw }}{% endblock %}

{% block body %}
<div class="container mt-5">

    {# CORRECTION : On concatène domain + logoUrl #}
    {% if logoUrl is defined and logoUrl %}
        <div class="text-center mb-4">
            <img src="{{ logoUrl }}" alt="{{ fromName }}" style="max-width: 200px;">
        </div>
    {% endif %}

    {% if fromName %}
        <div class="text-center mb-4">
            <h2>{{ fromName }}</h2>
        </div>
    {% endif %}

    <div class="alert alert-info" role="alert">
        <h4 class="alert-heading">{{ 'reset.greeting'|trans({'%name%': user.firstname|e}, 'emails', locale)|raw }}</h4>
        <p>{{ 'reset.requested'|trans({}, 'emails', locale)|raw }}</p>
        <hr>
        <p class="mb-0">{{ 'reset.click'|trans({}, 'emails', locale)|raw }}</p>
        
        {# Le resetUrl est déjà absolu et contient le tenant_host #}
        <p class="mb-0" style="margin: 20px 0;">
            <a href="{{ resetUrl }}" style="background-color: #007bff; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">{{ 'reset.button'|trans({}, 'emails', locale)|raw }}</a>
        </p>
        
        <p class="mt-3">{{ 'reset.expires'|trans({}, 'emails', locale)|raw }}</p>
        
        {% if signature %}
            <hr>
            <p class="mb-0">{{ signature|raw }}</p>
        {% endif %}
    </div>
</div>
{% endblock %}