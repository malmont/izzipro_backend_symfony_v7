<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ book.title }} - Intérieur</title>
    <style>
        @page {
            /* Format A4 (210 x 297 mm) + Fond perdu de 3.175 mm (0.125") sur les 4 côtés */
            size: 216.41mm 303.28mm;
            margin: 22mm 24mm 22mm 24mm;
        }

        body {
            font-family: 'DejaVu Serif', serif;
            font-size: 11pt;
            line-height: 1.65;
            color: #2c2c2c;
            background-color: #ffffff;
            margin: 0;
            padding: 0;
        }

        /* En-tête et pied de page */
        .page-header {
            position: fixed;
            top: -12mm;
            left: 0;
            right: 0;
            height: 8mm;
            font-size: 8.5pt;
            color: #888888;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            border-bottom: 0.5pt solid #e0e0e0;
            display: block;
            text-align: right;
        }

        .page-footer {
            position: fixed;
            bottom: -12mm;
            left: 0;
            right: 0;
            height: 8mm;
            font-size: 9pt;
            color: #777777;
            text-align: center;
        }

        /* Page de faux-titre : première page du livre, pas de break-before pour éviter une page 1 blanche */
        .half-title-page {
            page-break-before: avoid;
            page-break-after: always;
            text-align: center;
            padding-top: 80mm;
        }

        .half-title {
            font-size: 20pt;
            font-weight: normal;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #333333;
        }

        /* Page de grand titre */
        .title-page {
            page-break-before: avoid;
            page-break-after: always;
            text-align: center;
            padding-top: 60mm;
        }

        .main-title {
            font-size: 32pt;
            font-weight: bold;
            letter-spacing: 2px;
            color: #1a1a1a;
            margin-bottom: 5mm;
            line-height: 1.2;
        }

        .subtitle {
            font-size: 14pt;
            font-style: italic;
            color: #666666;
            margin-bottom: 40mm;
            font-weight: normal;
        }

        .author-name {
            font-size: 16pt;
            letter-spacing: 1px;
            color: #222222;
            margin-bottom: 30mm;
        }

        .collection-name {
            font-size: 10pt;
            text-transform: uppercase;
            letter-spacing: 4px;
            color: #b59449;
            font-weight: bold;
        }

        /* Page de sommaire */
        .toc-page {
            page-break-before: avoid;
            page-break-after: always;
            padding-top: 25mm;
        }

        .toc-title {
            font-size: 20pt;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #1a1a1a;
            border-bottom: 1pt solid #b59449;
            padding-bottom: 4mm;
            margin-bottom: 12mm;
            text-align: center;
        }

        .toc-item {
            margin-bottom: 6mm;
            font-size: 12pt;
            display: table;
            width: 100%;
        }

        .toc-item-title {
            display: table-cell;
            color: #333333;
        }

        .toc-item-dots {
            display: table-cell;
            border-bottom: 1pt dotted #aaaaaa;
            width: 30%;
        }

        /* Chapitres : saut de page avant chaque chapitre SAUF le premier qui suit directement le sommaire */
        .chapter-container {
            page-break-before: always;
            padding-top: 20mm;
        }

        .chapter-container.first-chapter {
            page-break-before: avoid !important;
        }

        .chapter-header {
            text-align: center;
            margin-bottom: 15mm;
            border-bottom: 0.5pt solid #dddddd;
            padding-bottom: 8mm;
        }

        .chapter-theme {
            font-size: 9pt;
            text-transform: uppercase;
            letter-spacing: 3px;
            color: #b59449;
            margin-bottom: 4mm;
            font-weight: bold;
        }

        .chapter-number {
            font-size: 11pt;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #888888;
            margin-bottom: 2mm;
        }

        .chapter-title {
            font-size: 24pt;
            color: #111111;
            margin: 0;
            font-weight: normal;
            line-height: 1.25;
        }

        /* Corps du récit */
        .story-content {
            text-align: justify;
            text-justify: inter-word;
            margin-bottom: 10mm;
        }

        .story-paragraph {
            margin-bottom: 5mm;
            text-indent: 6mm;
        }

        .story-paragraph:first-of-type {
            text-indent: 0;
        }

        /* Lettrine sur le premier paragraphe */
        .first-letter {
            float: left;
            font-size: 42pt;
            line-height: 35pt;
            padding-top: 2pt;
            padding-right: 4pt;
            padding-bottom: 0;
            color: #b59449;
            font-weight: bold;
        }

        /* ====================================================
           Planches Photos Dédiées (Albums de Prestige)
        ==================================================== */
        .photo-album-page {
            page-break-before: always;
            page-break-inside: avoid;
            padding-top: 5mm;
            text-align: center;
        }

        .photo-frame {
            background-color: #fdfdfd;
            border: 0.5pt solid #e0e0e0;
            padding: 2.5mm;
            border-radius: 2px;
            box-shadow: 0 1mm 2.5mm rgba(0,0,0,0.06);
            display: inline-block;
            box-sizing: border-box;
            max-width: 100%;
        }

        /* Gabarit 1 : Mosaïque 2x2 (grid_4) */
        .layout-grid-table {
            width: 100%;
            table-layout: fixed;
            border-collapse: collapse;
            border: none;
            margin: 0 auto;
        }

        .layout-grid-cell {
            width: 50%;
            padding: 2.5mm 3mm;
            vertical-align: middle;
            text-align: center;
        }

        .photo-img-grid {
            max-width: 100%;
            max-height: 98mm;
            display: block;
            margin: 0 auto;
        }

        /* Gabarit 2 : Deux photos côte à côte (duo_v) */
        .layout-duo-v-table {
            width: 100%;
            table-layout: fixed;
            border-collapse: collapse;
            border: none;
            margin: 15mm auto;
        }

        .layout-duo-v-cell {
            width: 50%;
            padding: 0 3.5mm;
            vertical-align: middle;
            text-align: center;
        }

        .photo-img-duo-v {
            max-width: 100%;
            max-height: 145mm;
            display: block;
            margin: 0 auto;
        }

        /* Gabarit 3 : Deux photos empilées horizontalement (duo_h) */
        .layout-duo-h-block {
            margin: 5mm auto 8mm auto;
            text-align: center;
        }

        .photo-img-duo-h {
            max-width: 95%;
            max-height: 105mm;
            display: block;
            margin: 0 auto;
        }

        /* Gabarit 4 : Grande photo pleine page (single) */
        .layout-single-block {
            padding-top: 15mm;
            text-align: center;
        }

        .photo-img-single {
            max-width: 90%;
            max-height: 185mm;
            display: block;
            margin: 0 auto;
        }

        /* Page de fin / colophon */
        .colophon-page {
            page-break-before: always;
            text-align: center;
            padding-top: 100mm;
            font-size: 9pt;
            color: #888888;
            line-height: 1.8;
        }

        .colophon-logo {
            max-width: 35mm;
            margin-bottom: 8mm;
        }
    </style>
</head>
<body>

    {# 1. Faux-titre #}
    <div class="half-title-page">
        <div class="half-title">{{ clean_title|default(book.title) }}</div>
    </div>

    {# 2. Grand Titre #}
    <div class="title-page">
        <div class="main-title">{{ clean_title|default(book.title) }}</div>
        {% if clean_subtitle or book.subtitle %}
            <div class="subtitle">{{ clean_subtitle|default(book.subtitle) }}</div>
        {% endif %}
        
        <div class="author-name">
            {{ author_name|default('Danielle Almont') }}
        </div>

        <div class="collection-name">MÉMOIRE VIVANTE</div>
    </div>

    {# 3. Sommaire #}
    <div class="toc-page">
        <div class="toc-title">Sommaire</div>
        {% for chapter in book.chapters %}
            <div class="toc-item">
                <span class="toc-item-title">
                    <strong>Chapitre {{ loop.index }}</strong> — {{ chapter.title }}
                </span>
            </div>
        {% endfor %}
    </div>

    {# 4. Contenu des Chapitres & Planches Photos Dédiées #}
    {% set chapters_list = chapters_data|default([]) %}
    {% for item in chapters_list %}
        {% set chapter = item.chapter %}
        <div class="chapter-container{% if loop.first %} first-chapter{% endif %}" style="{% if loop.first %}page-break-before: avoid !important;{% endif %}">
            <div class="chapter-header">
                {% if item.clean_theme %}
                    <div class="chapter-theme">{{ item.clean_theme|raw }}</div>
                {% endif %}
                <div class="chapter-number">Chapitre {{ loop.index }}</div>
                <h2 class="chapter-title">{{ item.clean_title|raw }}</h2>
            </div>

            <div class="story-content">
                {% if item.clean_content %}
                    {% set paragraphs = item.clean_content|split("\n\n") %}
                    {% for p in paragraphs %}
                        {% set pTrim = p|trim %}
                        {% if pTrim %}
                            <p class="story-paragraph">
                                {% if loop.first and pTrim|length > 1 %}
                                    <span class="first-letter">{{ pTrim|slice(0, 1)|raw }}</span>{{ pTrim|slice(1)|raw }}
                                {% else %}
                                    {{ pTrim|nl2br|raw }}
                                {% endif %}
                            </p>
                        {% endif %}
                    {% endfor %}
                {% endif %}
            </div>
        </div>

        {# Planches Photos Dédiées du Chapitre (Gabarits grid_4, duo_v, duo_h, single) #}
        {% if item.photo_pages is defined and item.photo_pages is not empty %}
            {% for ppage in item.photo_pages %}
                <div class="photo-album-page">
                    {% if ppage.layout == 'grid_4' %}
                        {# Gabarit 1 : Mosaïque 2x2 (Conforme au livre physique) #}
                        <table class="layout-grid-table">
                            {% for row in ppage.photos|batch(2) %}
                                <tr>
                                    {% for photo in row %}
                                        <td class="layout-grid-cell">
                                            {% if photo.filePath is defined and photo.filePath %}
                                                <div class="photo-frame">
                                                    <img src="{{ project_dir }}/public/uploads/memoires/{{ photo.filePath }}" class="photo-img-grid" alt="Photo">
                                                </div>
                                            {% endif %}
                                        </td>
                                    {% endfor %}
                                    {% if row|length == 1 %}
                                        <td class="layout-grid-cell"></td>
                                    {% endif %}
                                </tr>
                            {% endfor %}
                        </table>

                    {% elseif ppage.layout == 'duo_v' %}
                        {# Gabarit 2 : Deux photos côte à côte (Portrait) #}
                        <table class="layout-duo-v-table">
                            <tr>
                                {% for photo in ppage.photos %}
                                    <td class="layout-duo-v-cell">
                                        {% if photo.filePath is defined and photo.filePath %}
                                            <div class="photo-frame">
                                                <img src="{{ project_dir }}/public/uploads/memoires/{{ photo.filePath }}" class="photo-img-duo-v" alt="Photo">
                                            </div>
                                        {% endif %}
                                    </td>
                                {% endfor %}
                                {% if ppage.photos|length == 1 %}
                                    <td class="layout-duo-v-cell"></td>
                                {% endif %}
                            </tr>
                        </table>

                    {% elseif ppage.layout == 'duo_h' %}
                        {# Gabarit 3 : Deux photos empilées horizontalement (Paysage) #}
                        <div class="layout-duo-h-block">
                            {% for photo in ppage.photos %}
                                {% if photo.filePath is defined and photo.filePath %}
                                    <div class="photo-frame" style="margin-bottom: 5mm;">
                                        <img src="{{ project_dir }}/public/uploads/memoires/{{ photo.filePath }}" class="photo-img-duo-h" alt="Photo">
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>

                    {% else %}
                        {# Gabarit 4 : Grande photo pleine page (single) #}
                        <div class="layout-single-block">
                            {% if ppage.photos[0] is defined and ppage.photos[0].filePath %}
                                <div class="photo-frame">
                                    <img src="{{ project_dir }}/public/uploads/memoires/{{ ppage.photos[0].filePath }}" class="photo-img-single" alt="Photo">
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        {% endif %}
    {% endfor %}

    {# 5. Page finale Colophon #}
    <div class="colophon-page">
        <div>Cet ouvrage a été créé et mis en page avec le programme</div>
        <div style="font-weight: bold; font-size: 11pt; color: #111; margin: 2mm 0;">MÉMOIRE VIVANTE</div>
        <div>Impression &amp; Reliure de prestige à la demande</div>
        <div style="margin-top: 4mm;">&copy; {{ 'now'|date('Y') }} Tous droits réservés.</div>
    </div>

</body>
</html>
