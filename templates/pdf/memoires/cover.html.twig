<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ clean_title|default(book.title) }} - Couverture</title>
    {#
        Couverture dépliée : 4e de couverture (gauche), tranche, 1re de couverture (droite).

        Mise en page pour Dompdf, qui IGNORE « box-sizing » : un bloc « width: 100% » avec des marges internes déborde
        de son parent, et tout ce qui est positionné par rapport à lui (« right », « bottom ») part hors de la page.
        Règle suivie ici : chaque bloc est positionné en absolu avec une largeur explicite, sans marge interne sur un
        bloc dimensionné.

        Zone visible : autour de chaque plat, « edge_pt » (rembordage + fond perdu) est replié autour du carton. Les
        fonds et photos vont jusqu'au bord de la page ; les textes sont centrés sur la zone visible (visible_*_pt).
    #}
    {% set mm = 2.8346 %}
    {% set fw = front_cover_width_pt %}
    {% set fh = cover_height_pt %}
    {% set vw = visible_width_pt %}
    {% set vh = visible_height_pt %}
    {% set top0 = edge_pt %}
    {% set title = clean_title|default(book.title) %}
    {% set subtitle = clean_subtitle|default(book.subtitle) %}
    {% set has_photo = cover_image_exists %}
    {% set style = (cover_style in ['full_photo', 'gallery_frame', 'modern_banner'] and has_photo) ? cover_style
        : ((cover_style == 'classic_text' or not has_photo) ? 'classic_text' : 'biographic_split') %}
    {# Fond de la 4e de couverture et de la tranche : couleur choisie, sinon celle du style classique, sinon neutre #}
    {% set back_bg = style == 'classic_text' ? classic_bg : (bg_color ?: '#fbfbfb') %}
    {% set back_dark = style == 'classic_text' ? classic_is_dark : bg_is_dark %}
    {% set spine_bg = style == 'classic_text' ? classic_bg : (bg_color ?: '#b59449') %}
    {% set spine_dark = style == 'classic_text' ? classic_is_dark : (bg_color ? bg_is_dark : true) %}
    <style>
        @page {
            size: {{ cover_width_pt }}pt {{ cover_height_pt }}pt;
            margin: 0;
        }

        body {
            margin: 0;
            padding: 0;
            {# Police du livre : valeur du catalogue BookFontCatalog (constantes), d'où le filtre raw #}
            font-family: {{ font_css|default("'DejaVu Serif', serif")|raw }};
        }

        .abs { position: absolute; }

        .cover-container {
            position: absolute;
            top: 0;
            left: 0;
            width: {{ cover_width_pt }}pt;
            height: {{ cover_height_pt }}pt;
            overflow: hidden;
        }

        /* ---------------- 4e de couverture ---------------- */
        .back-cover {
            position: absolute;
            top: 0;
            left: 0;
            width: {{ back_cover_width_pt }}pt;
            height: {{ fh }}pt;
            overflow: hidden;
            background-color: {{ back_bg }};
        }

        .back-quote {
            position: absolute;
            top: {{ top0 + 75 * mm }}pt;
            left: {{ edge_pt + 28 * mm }}pt;
            width: {{ vw - 56 * mm }}pt;
            text-align: center;
            font-size: 15pt;
            font-style: italic;
            line-height: 1.8;
            color: {{ back_dark ? '#f7f1e3' : '#333333' }};
        }

        .back-logo {
            position: absolute;
            top: {{ top0 + vh - 32 * mm }}pt;
            left: {{ edge_pt }}pt;
            width: {{ vw }}pt;
            text-align: center;
            font-size: 11pt;
            letter-spacing: 4px;
            text-transform: uppercase;
            font-weight: bold;
            color: {{ back_dark ? '#c5a059' : '#b59449' }};
        }

        /* ---------------- Tranche ---------------- */
        .spine-cell {
            position: absolute;
            top: 0;
            left: {{ back_cover_width_pt }}pt;
            width: {{ spine_width_pt }}pt;
            height: {{ fh }}pt;
            overflow: hidden;
            text-align: center;
            background-color: {{ spine_bg }};
        }

        .spine-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(90deg);
            white-space: nowrap;
            font-size: {{ spine_pt|default(10) }}pt;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: {{ spine_dark ? '#ffffff' : '#2b3a42' }};
        }

        /* ---------------- 1re de couverture ---------------- */
        .front-cover {
            position: absolute;
            top: 0;
            left: {{ back_cover_width_pt + spine_width_pt }}pt;
            width: {{ fw }}pt;
            height: {{ fh }}pt;
            overflow: hidden;
            background-color: #ffffff;
        }

        .photo {
            position: absolute;
            background-image: url('{{ cover_image_path }}');
            background-size: cover;
            background-repeat: no-repeat;
        }

        .brand {
            font-size: 10pt;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-weight: bold;
            color: #b59449;
        }

        .author {
            font-style: italic;
            margin-bottom: 4mm;
        }

        /* Un titre ne passe à la ligne qu'entre deux mots : pas de « word-wrap: break-word » ni de césure. Son corps
           (title_pt, calculé par BookPdfGeneratorService::fitFontSize) garantit que le mot le plus long tient. */
        .title {
            font-weight: bold;
            {# Police des titres : valeur du catalogue BookFontCatalog (constantes), d'où le filtre raw #}
            font-family: {{ title_font_css|default("'DejaVu Serif', serif")|raw }};
        }
    </style>
</head>
<body>

    <div class="cover-container">

        {# ---------------- 1. 4e de couverture ---------------- #}
        <div class="back-cover">
            <div class="back-quote">
                {% if subtitle %}
                    &laquo;&nbsp;{{ subtitle }}&nbsp;&raquo;
                {% else %}
                    &laquo;&nbsp;Chaque vie est une histoire qui mérite d'être racontée et transmise aux générations futures.&nbsp;&raquo;
                {% endif %}
            </div>
            <div class="back-logo">Mémoire Vivante</div>
        </div>

        {# ---------------- 2. Tranche ---------------- #}
        <div class="spine-cell"{% if style == 'classic_text' %} style="border-left: 0.5pt solid #c5a059; border-right: 0.5pt solid #c5a059;"{% endif %}>
            <div class="spine-text">
                {{ title }}{% if author_name %}&nbsp;&bull;&nbsp;{{ author_name }}{% endif %}
            </div>
        </div>

        {# ---------------- 3. 1re de couverture ---------------- #}
        <div class="front-cover">
            {% if style == 'full_photo' %}
                {# PLEINE PAGE : photo à fond perdu, bandeaux sombres sous les textes (Dompdf n'a pas de dégradé) #}
                {% set pad = 25 * mm %}
                <div class="photo" style="top: 0; left: 0; width: {{ fw }}pt; height: {{ fh }}pt; background-position: center center;"></div>
                <div class="abs" style="top: 0; left: 0; width: {{ fw }}pt; height: {{ top0 + 92 * mm }}pt; background-color: rgba(0, 0, 0, 0.45);"></div>
                <div class="abs" style="top: {{ fh - top0 - 52 * mm }}pt; left: 0; width: {{ fw }}pt; height: {{ top0 + 52 * mm }}pt; background-color: rgba(0, 0, 0, 0.55);"></div>
                <div class="abs" style="top: {{ top0 + 22 * mm }}pt; left: {{ pad }}pt; width: {{ vw - 2 * pad }}pt; color: #ffffff;">
                    <div class="title" style="font-size: {{ title_pt.full }}pt; line-height: 1.1; margin-bottom: 7mm;">{{ title }}</div>
                    {% if subtitle %}
                        <div style="font-size: 14pt; line-height: 1.4; color: #f3e5ab;">{{ subtitle }}</div>
                    {% endif %}
                </div>
                <div class="abs" style="top: {{ fh - top0 - 38 * mm }}pt; left: {{ pad }}pt; width: {{ vw - 2 * pad }}pt; color: #ffffff;">
                    {% if author_name %}<div class="author" style="font-size: 22pt;">{{ author_name }}</div>{% endif %}
                    <div class="brand" style="color: #f3e5ab; letter-spacing: 4px;">Mémoire Vivante</div>
                </div>

            {% elseif style == 'gallery_frame' %}
                {# CADRE GALERIE : titre, photo encadrée, auteur, centrés sur la zone visible #}
                {% set pad = 25 * mm %}
                {% set frame_w = vw * 0.62 %}
                {% set frame_h = vh * 0.45 %}
                {% set frame_top = top0 + 86 * mm %}
                <div class="abs" style="top: 0; left: 0; width: {{ fw }}pt; height: {{ fh }}pt; background-color: #faf8f3;"></div>
                <div class="abs" style="top: {{ top0 + 24 * mm }}pt; left: {{ pad }}pt; width: {{ vw - 2 * pad }}pt; text-align: center;">
                    <div class="title" style="font-size: {{ title_pt.gallery }}pt; line-height: 1.15; {% if not script_titles|default(false) %}letter-spacing: 1px; {% endif %}color: #1a1a1a; margin-bottom: 4mm;">{{ title }}</div>
                    {% if subtitle %}
                        <div style="font-size: 12pt; font-style: italic; color: #b59449;">{{ subtitle }}</div>
                    {% endif %}
                </div>
                <div class="abs" style="top: {{ frame_top }}pt; left: {{ (vw - frame_w) / 2 }}pt; width: {{ frame_w - 6 }}pt; height: {{ frame_h - 6 }}pt; border: 3pt solid #b59449; background-color: #ffffff;"></div>
                <div class="photo" style="top: {{ frame_top + 9 }}pt; left: {{ (vw - frame_w) / 2 + 9 }}pt; width: {{ frame_w - 18 }}pt; height: {{ frame_h - 18 }}pt; background-position: center center;"></div>
                <div class="abs" style="top: {{ fh - top0 - 40 * mm }}pt; left: {{ pad }}pt; width: {{ vw - 2 * pad }}pt; text-align: center;">
                    {% if author_name %}<div class="author" style="font-size: 18pt; color: #222222;">{{ author_name }}</div>{% endif %}
                    <div class="brand" style="font-size: 9pt; letter-spacing: 4px;">Mémoire Vivante</div>
                </div>

            {% elseif style == 'modern_banner' %}
                {# BANDEAU MODERNE : titre en haut, photo en bandeau à fond perdu, auteur en bas #}
                {% set pad = 25 * mm %}
                {% set band_top = top0 + vh * 0.27 %}
                {% set band_h = vh * 0.50 %}
                <div class="abs" style="top: {{ top0 + 22 * mm }}pt; left: {{ pad }}pt; width: {{ vw - 2 * pad }}pt;">
                    <div class="title" style="font-size: {{ title_pt.banner }}pt; line-height: 1.1; color: #111111; margin-bottom: 3mm;">{{ title }}</div>
                    {% if subtitle %}
                        <div style="font-size: 12pt; color: #b59449;">{{ subtitle }}</div>
                    {% endif %}
                </div>
                <div class="photo" style="top: {{ band_top }}pt; left: 0; width: {{ fw }}pt; height: {{ band_h }}pt; background-position: center center;"></div>
                <div class="abs" style="top: {{ band_top + band_h + 16 * mm }}pt; left: {{ pad }}pt; width: {{ vw - 2 * pad }}pt;">
                    {% if author_name %}<div class="author" style="font-size: 20pt; color: #1a1a1a;">{{ author_name }}</div>{% endif %}
                    <div class="brand">Mémoire Vivante</div>
                </div>

            {% elseif style == 'classic_text' %}
                {# CLASSIQUE TYPOGRAPHIQUE (aussi quand aucune photo de couverture n'est fournie) #}
                {% set gold = '#c5a059' %}
                {% set ink = classic_is_dark ? '#f7f1e3' : '#1f2d34' %}
                {% set fx = 18 * mm %}
                {% set fy = top0 + 16 * mm %}
                {% set frame_w = vw - 2 * fx %}
                {% set frame_h = vh - 32 * mm %}
                <div class="abs" style="top: 0; left: 0; width: {{ fw }}pt; height: {{ fh }}pt; background-color: {{ classic_bg }};"></div>
                <div class="abs" style="top: {{ fy }}pt; left: {{ fx }}pt; width: {{ frame_w - 4 }}pt; height: {{ frame_h - 4 }}pt; border: 2pt solid {{ gold }};"></div>
                <div class="abs" style="top: {{ fy + 6 }}pt; left: {{ fx + 6 }}pt; width: {{ frame_w - 13.5 }}pt; height: {{ frame_h - 13.5 }}pt; border: 0.75pt solid {{ gold }};"></div>
                <div class="abs" style="top: {{ fy + 42 * mm }}pt; left: {{ fx + 17 * mm }}pt; width: {{ frame_w - 34 * mm }}pt; text-align: center;">
                    {# Ornement : losanges de la police DejaVu Sans (la Serif n'a pas ces caractères) #}
                    <div style="font-family: 'DejaVu Sans', sans-serif; font-size: 12pt; letter-spacing: 6px; color: {{ gold }}; margin-bottom: 20mm;">&#9670;&nbsp;&#9670;&nbsp;&#9670;</div>
                    <div class="title" style="font-size: {{ title_pt.classic }}pt; line-height: 1.15; {% if not script_titles|default(false) %}letter-spacing: 2px; text-transform: uppercase; {% endif %}color: {{ ink }}; margin-bottom: 8mm;">{{ title }}</div>
                    {% if subtitle %}
                        <div style="font-size: 14pt; font-style: italic; line-height: 1.5; color: {{ gold }};">{{ subtitle }}</div>
                    {% endif %}
                </div>
                <div class="abs" style="top: {{ fy + frame_h - 62 * mm }}pt; left: {{ fx + 17 * mm }}pt; width: {{ frame_w - 34 * mm }}pt; text-align: center;">
                    {% if author_name %}<div style="font-size: 22pt; letter-spacing: 1px; color: {{ classic_is_dark ? '#ffffff' : '#1a1a1a' }}; margin-bottom: 6mm;">{{ author_name }}</div>{% endif %}
                    <div class="brand" style="letter-spacing: 4px; color: {{ gold }};">Mémoire Vivante</div>
                </div>

            {% else %}
                {# SIGNATURE BIOGRAPHIQUE (défaut) : photo à gauche, colonne de titre à droite #}
                {% set photo_w = vw * 0.52 %}
                {% set pad = 14 * mm %}
                {% set col_x = photo_w + pad %}
                {% set col_w = vw - photo_w - 2 * pad %}
                <div class="photo" style="top: 0; left: 0; width: {{ photo_w }}pt; height: {{ fh }}pt; background-position: center top;"></div>
                <div class="abs" style="top: {{ top0 + 30 * mm }}pt; left: {{ col_x }}pt; width: {{ col_w }}pt;">
                    <div class="title" style="font-size: {{ title_pt.biographic }}pt; line-height: 1.05; color: #1f2d34; margin-bottom: 14mm;">{{ title }}</div>
                    {% if subtitle %}
                        <div style="font-size: 13pt; line-height: 1.5; color: #b59449;">{{ subtitle }}</div>
                    {% endif %}
                </div>
                <div class="abs" style="top: {{ fh - top0 - 42 * mm }}pt; left: {{ col_x }}pt; width: {{ col_w }}pt;">
                    {% if author_name %}<div class="author" style="font-size: 18pt; color: #1a1a1a;">{{ author_name }}</div>{% endif %}
                    <div class="brand" style="font-size: 9pt;">Mémoire Vivante</div>
                </div>
            {% endif %}
        </div>
    </div>

</body>
</html>
