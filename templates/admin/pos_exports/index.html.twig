{% extends 'base_admin.html.twig' %}

{% block title %}Exports comptables (caisse){% endblock %}

{% block body %}
<div class="container-fluid">
    <h1 class="mb-3">Exports comptables (caisse)</h1>
    <p class="text-muted">À partir des sessions clôturées (rapports Z). Un rapport Z entier est rattaché à la date d'ouverture de sa session, dans le fuseau du magasin. Synthèse et écritures « generic » : CSV pour Excel en français (« ; », virgule décimale) ; « qbo » : QuickBooks Online (« , », point décimal, dates JJ/MM/AAAA, colonnes JournalNo, JournalDate, AccountName, Description, Debits, Credits).</p>
    {% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
    <form method="post" class="row g-2 align-items-end mb-4">
        <div class="col-md-2"><label class="form-label">Du</label><input type="date" name="from" class="form-control" value="{{ params.from }}"></div>
        <div class="col-md-2"><label class="form-label">Au</label><input type="date" name="to" class="form-control" value="{{ params.to }}"></div>
        <div class="col-md-3"><label class="form-label">Poste de caisse</label>
            <select name="cashRegisterId" class="form-select"><option value="">Tous les postes</option>
            {% for r in registers %}<option value="{{ r.id }}" {{ params.cashRegisterId == r.id ? 'selected' : '' }}>{{ r.name }}</option>{% endfor %}</select></div>
        <div class="col-md-5">
            <button type="submit" name="format" value="preview" class="btn btn-secondary">Aperçu</button>
            <button type="submit" name="format" value="summary" class="btn btn-primary">Synthèse CSV par jour</button>
            <button type="submit" name="format" value="generic" class="btn btn-primary">Écritures CSV</button>
            <button type="submit" name="format" value="qbo" class="btn btn-outline-primary">Écritures QuickBooks</button>
        </div>
    </form>
    {% if preview %}
        <p><strong>{{ preview.reports|length }}</strong> rapport(s) Z, fuseau {{ preview.timezone }} ; débits {{ (preview.totals.debit / 100)|number_format(2, ',', ' ') }} / crédits {{ (preview.totals.credit / 100)|number_format(2, ',', ' ') }}
            {% if preview.totals.balanced %}<span class="badge bg-success">équilibré</span>{% else %}<span class="badge bg-danger">déséquilibré</span>{% endif %}
            {% if preview.legacyNote %}<br><span class="text-warning">{{ preview.legacyNote }} : {{ preview.legacyReports|join(', ') }}</span>{% endif %}</p>
        <table class="table table-sm table-striped">
            <thead><tr><th>Jour</th><th>Pièces</th><th class="text-end">Ventes</th><th class="text-end">HT net</th><th class="text-end">TTC</th><th class="text-end">Retours</th><th class="text-end">Cartes-cadeaux vendues</th><th class="text-end">Écart</th><th class="text-end">Dépôt banque</th></tr></thead>
            <tbody>{% for d in preview.days %}<tr><td>{{ d.date }}</td><td>{{ d.pieces|join(' ') }}</td><td class="text-end">{{ d.salesCount }}</td><td class="text-end">{{ (d.salesNetHt / 100)|number_format(2, ',', ' ') }}</td><td class="text-end">{{ (d.salesTtc / 100)|number_format(2, ',', ' ') }}</td><td class="text-end">{{ (d.refundsTtc / 100)|number_format(2, ',', ' ') }}</td><td class="text-end">{{ (d.giftCardsSold / 100)|number_format(2, ',', ' ') }}</td><td class="text-end">{{ (d.discrepancy / 100)|number_format(2, ',', ' ') }}</td><td class="text-end">{{ (d.bankDeposit / 100)|number_format(2, ',', ' ') }}</td></tr>{% endfor %}</tbody>
        </table>
        <h5>Écritures</h5>
        <table class="table table-sm">
            <thead><tr><th>Date</th><th>Pièce</th><th>Compte</th><th>Libellé</th><th class="text-end">Débit</th><th class="text-end">Crédit</th></tr></thead>
            <tbody>{% for l in preview.entries %}<tr><td>{{ l.date }}</td><td>{{ l.piece }}</td><td>{{ l.account }} {{ l.accountName }}</td><td>{{ l.label }}</td><td class="text-end">{{ l.debit ? (l.debit / 100)|number_format(2, ',', ' ') : '' }}</td><td class="text-end">{{ l.credit ? (l.credit / 100)|number_format(2, ',', ' ') : '' }}</td></tr>{% endfor %}</tbody>
        </table>
    {% endif %}
</div>
{% endblock %}
