{# IA pour un produit (07/11/2026) : habillage EasyAdmin depuis la fiche, sinon page nue #}
{% extends ea() is not null ? '@EasyAdmin/page/content.html.twig' : 'base_admin.html.twig' %}
{% set title = 'IA pour « ' ~ product.name ~ ' »' %}

{% block title %}{{ title }}{% endblock %}
{% block content_title %}{{ title }}{% endblock %}
{% block main %}{{ block('panel') }}{% endblock %}
{% block body %}{% if ea() is null %}<div class="py-3">{{ block('panel') }}</div>{% else %}{{ parent() }}{% endif %}{% endblock %}

{% block panel %}
<div class="container-fluid" style="max-width: 900px" data-product-ai="{{ productId }}">
    <h1 class="h3 mb-1">{{ title }}</h1>
    <p class="text-muted">Trois actions sur ce produit, à partir de ses photos ({{ pictures }} photo(s), dont {{ aiPictures }} générée(s)). {% if charge %}Crédits restants ce mois-ci : <strong>{{ credits.remaining ?? '?' }}</strong>.{% else %}Propriétaire de la plateforme : aucun crédit décompté.{% endif %}</p>
    {% for label, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ label }}">{{ message }}</div>{% endfor %}{% endfor %}
    {% if pictures == 0 %}<div class="alert alert-warning">Ce produit n'a aucune photo : ajoutez-en une sur la fiche, l'IA s'appuie dessus.</div>{% endif %}

    <div class="row g-3">
        <div class="col-md-4"><div class="card h-100"><div class="card-body d-flex flex-column">
            <h2 class="h6">Rédiger la description</h2>
            <p class="small text-muted">L'IA relit les photos et le nom, puis écrit la description, les informations complémentaires et les mots-clés. {{ hasDescription ? 'La description actuelle sera remplacée.' : 'Aucune description aujourd\'hui.' }}</p>
            <form method="post" action="{{ path('admin_product_ai_run', {id: productId, action: 'decrire'}) }}" class="mt-auto" data-ai-action="decrire"><input type="hidden" name="_token" value="{{ csrf_token(csrfToken) }}"><button class="btn btn-primary btn-sm" {% if pictures == 0 %}disabled{% endif %}>Rédiger ({{ costs.describe }} crédit)</button></form>
        </div></div></div>
        <div class="col-md-4"><div class="card h-100"><div class="card-body d-flex flex-column">
            <h2 class="h6">Traduire en français et en anglais</h2>
            <p class="small text-muted">Langues présentes : {{ translations|join(', ') ?: 'aucune' }}. Les langues manquantes sont ajoutées ; cochez pour tout retraduire.</p>
            <form method="post" action="{{ path('admin_product_ai_run', {id: productId, action: 'traduire'}) }}" class="mt-auto" data-ai-action="traduire"><input type="hidden" name="_token" value="{{ csrf_token(csrfToken) }}"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="overwrite" value="1" id="ovw"><label class="form-check-label small" for="ovw">Retraduire même les langues déjà présentes</label></div><button class="btn btn-primary btn-sm">Traduire ({{ costs.translate }} crédit)</button></form>
        </div></div></div>
        <div class="col-md-4"><div class="card h-100"><div class="card-body d-flex flex-column">
            <h2 class="h6">Produire une image</h2>
            <p class="small text-muted">Depuis une photo existante : un packshot (produit seul sur fond propre, sans mannequin) ou une personne portant le vêtement.{% if not imagesAvailable %} <strong>Disponible dès que la plateforme branche son fournisseur d'images.</strong>{% endif %}</p>
            <form method="post" action="{{ path('admin_product_ai_run', {id: productId, action: 'image'}) }}" class="mt-auto" data-ai-action="image"><input type="hidden" name="_token" value="{{ csrf_token(csrfToken) }}">
                <select class="form-select form-select-sm mb-2" name="style"><option value="packshot">Packshot, sans mannequin</option><option value="mannequin">Personne portant le vêtement</option></select>
                <button class="btn btn-primary btn-sm" {% if pictures == 0 or not imagesAvailable %}disabled{% endif %}>Produire ({{ costs.image }} crédits)</button></form>
        </div></div></div>
    </div>
    <a class="btn btn-link mt-3" href="{{ backUrl }}">Retour à la fiche produit</a>
</div>
{% endblock %}
