{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Tableau de Bord E-Commerce{% endblock %}

{% block content_header %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="m-0 font-weight-bold">Tableau de Bord E-Commerce</h1>
            <p class="text-muted m-0">Aperçu général des ventes, répartitions, taxes et stock en temps réel</p>
        </div>
        <div class="d-flex align-items-center">
            <form action="{{ path('admin_redis_flush') }}" method="POST" onsubmit="return confirm('Voulez-vous vraiment vider le cache Redis (flushall) ?');" class="d-inline mr-2">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_redis_flush') }}">
                <button type="submit" class="btn btn-danger shadow-sm rounded-pill px-3" title="Vider tout le cache Redis (flushall)">
                    <i class="fas fa-trash-alt mr-1"></i> Vider cache Redis
                </button>
            </form>
            <a href="{{ ea_url().setController('App\\Controller\\Admin\\OrderAllCrudController').setAction('new') }}" class="btn btn-primary shadow-sm rounded-pill px-3">
                <i class="fas fa-plus mr-1"></i> Nouvelle Commande
            </a>
            <a href="{{ ea_url().setController('App\\Controller\\Admin\\ProductCrudController').setAction('new') }}" class="btn btn-outline-secondary shadow-sm rounded-pill px-3 ml-2">
                <i class="fas fa-box mr-1"></i> Ajouter Produit
            </a>
        </div>
    </div>
{% endblock %}

{% block main %}
<div class="container-fluid px-0">

    {# ------------------ KPIS / METRICS CARDS (ROW 1) ------------------ #}
    <div class="row mb-4">
        <!-- Total Sales Card -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-lg h-100 p-3 bg-white" style="border-left: 4px solid #4e73df !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Chiffre d'Affaires</div>
                        <div class="h3 mb-0 font-weight-bold text-gray-800">{{ totalSales|number_format(2, ',', ' ') }} $</div>
                        {% if salesDiffPercent >= 0 %}
                            <span class="badge bg-light text-success mt-2"><i class="fas fa-arrow-up"></i> +{{ salesDiffPercent }}% vs mois dernier</span>
                        {% else %}
                            <span class="badge bg-light text-danger mt-2"><i class="fas fa-arrow-down"></i> {{ salesDiffPercent }}% vs mois dernier</span>
                        {% endif %}
                    </div>
                    <div class="icon-circle text-primary p-3 rounded-circle" style="background-color: rgba(78, 115, 223, 0.1);">
                        <i class="fas fa-dollar-sign fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Orders Card -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-lg h-100 p-3 bg-white" style="border-left: 4px solid #1cc88a !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total Commandes</div>
                        <div class="h3 mb-0 font-weight-bold text-gray-800">{{ totalOrders }}</div>
                        {% if ordersDiffPercent >= 0 %}
                            <span class="badge bg-light text-success mt-2"><i class="fas fa-arrow-up"></i> +{{ ordersDiffPercent }}% vs mois dernier</span>
                        {% else %}
                            <span class="badge bg-light text-danger mt-2"><i class="fas fa-arrow-down"></i> {{ ordersDiffPercent }}% vs mois dernier</span>
                        {% endif %}
                    </div>
                    <div class="icon-circle text-success p-3 rounded-circle" style="background-color: rgba(28, 200, 138, 0.1);">
                        <i class="fas fa-shopping-cart fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Average Order Value Card -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-lg h-100 p-3 bg-white" style="border-left: 4px solid #36b9cc !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Panier Moyen</div>
                        <div class="h3 mb-0 font-weight-bold text-gray-800">{{ avgOrderValue|number_format(2, ',', ' ') }} $</div>
                        {% if avgDiffPercent >= 0 %}
                            <span class="badge bg-light text-success mt-2"><i class="fas fa-arrow-up"></i> +{{ avgDiffPercent }}% ce mois</span>
                        {% else %}
                            <span class="badge bg-light text-danger mt-2"><i class="fas fa-arrow-down"></i> {{ avgDiffPercent }}% ce mois</span>
                        {% endif %}
                    </div>
                    <div class="icon-circle text-info p-3 rounded-circle" style="background-color: rgba(54, 185, 204, 0.1);">
                        <i class="fas fa-calculator fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Taxes Collected Card -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-lg h-100 p-3 bg-white" style="border-left: 4px solid #f6c23e !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Taxes Collectées</div>
                        <div class="h3 mb-0 font-weight-bold text-gray-800">{{ totalTaxes|number_format(2, ',', ' ') }} $</div>
                        <span class="badge bg-light text-warning mt-2"><i class="fas fa-receipt"></i> Cumul Taxes</span>
                    </div>
                    <div class="icon-circle text-warning p-3 rounded-circle" style="background-color: rgba(246, 194, 62, 0.1);">
                        <i class="fas fa-percent fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ------------------ STOCK & INVENTORY METRICS (ROW 2) ------------------ #}
    <div class="row mb-4">
        <!-- Stock Value Overall -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-lg h-100 p-3 bg-white" style="border-left: 4px solid #6f42c1 !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs font-weight-bold text-uppercase mb-1" style="color: #6f42c1;">Stock Total Global</div>
                        <div class="h4 mb-0 font-weight-bold text-gray-800">{{ stockValue|number_format(2, ',', ' ') }} $</div>
                        <span class="small text-muted">Inventaire global actif</span>
                    </div>
                    <div class="icon-circle p-3 rounded-circle" style="background-color: rgba(111, 66, 193, 0.1); color: #6f42c1;">
                        <i class="fas fa-boxes fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Vehicle & Boat Stock -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-lg h-100 p-3 bg-white" style="border-left: 4px solid #00b894 !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs font-weight-bold text-uppercase mb-1" style="color: #00b894;">🚤 Véhicules & Embarcations</div>
                        <div class="h4 mb-0 font-weight-bold text-gray-800">{{ vehicleStockValue|number_format(2, ',', ' ') }} $</div>
                        <span class="small text-muted">Stock nautique & véhicules</span>
                    </div>
                    <div class="icon-circle p-3 rounded-circle" style="background-color: rgba(0, 184, 148, 0.1); color: #00b894;">
                        <i class="fas fa-ship fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Product & Accessories Stock -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-lg h-100 p-3 bg-white" style="border-left: 4px solid #0984e3 !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs font-weight-bold text-uppercase mb-1" style="color: #0984e3;">📦 Produits & Accessoires</div>
                        <div class="h4 mb-0 font-weight-bold text-gray-800">{{ productStockValue|number_format(2, ',', ' ') }} $</div>
                        <span class="small text-muted">Boutique & pièces</span>
                    </div>
                    <div class="icon-circle p-3 rounded-circle" style="background-color: rgba(9, 132, 227, 0.1); color: #0984e3;">
                        <i class="fas fa-box-open fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stock Alerts Combined -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-lg h-100 p-3 bg-white" style="border-left: 4px solid #e74a3b !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Alertes Inventaire</div>
                        <div class="h6 mb-1 font-weight-bold text-danger"><i class="fas fa-exclamation-circle"></i> {{ outOfStockCount }} Rupture(s)</div>
                        <div class="h6 mb-0 font-weight-bold text-warning"><i class="fas fa-exclamation-triangle"></i> {{ lowStockCount }} Stock(s) Faible(s)</div>
                    </div>
                    <div class="icon-circle text-danger p-3 rounded-circle" style="background-color: rgba(231, 74, 59, 0.1);">
                        <i class="fas fa-warehouse fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ------------------ CURRENT TENANT VISITOR & TRAFFIC ANALYTICS ------------------ #}
    <div class="row mb-3 mt-2">
        <div class="col-12 d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <h5 class="font-weight-bold mb-1">
                    <i class="fas fa-chart-line text-primary mr-2"></i>Fréquentation & Visiteurs : <span class="text-primary">{{ tenantReport.tenant_name }}</span>
                </h5>
                <p class="text-muted small mb-0">
                    Statistiques de fréquentation en temps réel et pages les plus visitées sur <strong>{{ tenantReport.domain }}</strong>
                </p>
            </div>
            <div class="d-flex align-items-center mt-2 mt-sm-0">
                <span class="badge shadow-sm border px-3 py-2 rounded-pill mr-2 live-badge">
                    <span class="live-dot mr-1"></span> Suivi Temps Réel (Redis)
                </span>
                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 shadow-sm" type="button" data-toggle="collapse" data-target="#allTenantsCollapse" aria-expanded="false" aria-controls="allTenantsCollapse">
                    <i class="fas fa-network-wired mr-1"></i> Comparer tous les sites
                </button>
            </div>
        </div>
    </div>

    <!-- 4 KPI Cards for the Current Tenant -->
    <div class="row mb-4">
        <!-- Live Online Visitors on Current Site -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-lg h-100 p-3 bg-white" style="border-left: 4px solid #28a745 !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                            <span class="live-dot mr-1"></span> En Direct sur Votre Site
                        </div>
                        <div class="h3 mb-0 font-weight-bold text-gray-800">{{ tenantReport.online|default(0) }}</div>
                        <span class="small text-muted">Connecté(s) (dernières 15 min)</span>
                    </div>
                    <div class="icon-circle p-3 rounded-circle" style="background-color: rgba(40, 167, 69, 0.1); color: #28a745;">
                        <i class="fas fa-user-clock fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Unique Visitors Today on Current Site -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-lg h-100 p-3 bg-white" style="border-left: 4px solid #4e73df !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Visiteurs Uniques Aujourd'hui</div>
                        <div class="h3 mb-0 font-weight-bold text-gray-800">{{ tenantReport.today_unique|default(0) }}</div>
                        <span class="small text-muted">IPs anonymisées sur 24h</span>
                    </div>
                    <div class="icon-circle text-primary p-3 rounded-circle" style="background-color: rgba(78, 115, 223, 0.1);">
                        <i class="fas fa-users fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Unique Visitors This Month on Current Site -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-lg h-100 p-3 bg-white" style="border-left: 4px solid #6f42c1 !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs font-weight-bold text-uppercase mb-1" style="color: #6f42c1;">Visiteurs ce Mois</div>
                        <div class="h3 mb-0 font-weight-bold text-gray-800">{{ tenantReport.month_unique|default(0) }}</div>
                        <span class="small text-muted">Cumul mensuel dédupliqué</span>
                    </div>
                    <div class="icon-circle p-3 rounded-circle" style="background-color: rgba(111, 66, 193, 0.1); color: #6f42c1;">
                        <i class="fas fa-calendar-check fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Pages / Requests Viewed on Current Site -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-lg h-100 p-3 bg-white" style="border-left: 4px solid #fd7e14 !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1" style="color: #fd7e14 !important;">Pages Vues / Requêtes</div>
                        <div class="h3 mb-0 font-weight-bold text-gray-800">{{ tenantReport.today_views|default(0) }}</div>
                        <span class="small text-muted">{{ tenantReport.total_views|default(0) }} vues au total</span>
                    </div>
                    <div class="icon-circle p-3 rounded-circle" style="background-color: rgba(253, 126, 20, 0.1); color: #fd7e14;">
                        <i class="fas fa-eye fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Row: Top Visited Pages (Left) & 7-Day Trend Chart (Right) -->
    <div class="row mb-4">
        <!-- Top Pages Table for Current Tenant -->
        <div class="col-xl-7 mb-4 mb-xl-0">
            <div class="card border-0 shadow-sm rounded-lg h-100 bg-white">
                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-fire mr-2 text-danger"></i>Pages les Plus Visitées de votre Site
                    </h6>
                    <span class="badge bg-light text-muted font-weight-normal">Top URLs consultées</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-items-center table-flush mb-0 table-hover">
                            <thead>
                                <tr>
                                    <th class="border-0 font-weight-bold">Rang & Page du Site</th>
                                    <th class="border-0 font-weight-bold text-center">Consultations</th>
                                    <th class="border-0 font-weight-bold" style="min-width: 130px;">Part d'Audience</th>
                                    <th class="border-0 font-weight-bold text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if tenantReport.top_pages|default([])|length > 0 %}
                                    {% for idx, page in tenantReport.top_pages %}
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <span class="badge {% if idx == 0 %}badge-primary{% elseif idx == 1 %}badge-info{% else %}badge-light text-muted border{% endif %} rounded-circle mr-2" style="width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center; font-size: 11px;">
                                                        {{ idx + 1 }}
                                                    </span>
                                                    <div>
                                                        {% if page.path == '/' %}
                                                            <span class="font-weight-bold" style="font-size: 13px;">
                                                                Page d'accueil (Landing Page)
                                                            </span>
                                                            <span class="badge bg-light text-muted ml-1" style="font-size: 10px;">/</span>
                                                        {% elseif page.path == '/services' %}
                                                            <span class="font-weight-bold" style="font-size: 13px;">
                                                                Nos Services
                                                            </span>
                                                            <span class="badge bg-light text-muted ml-1" style="font-size: 10px;">/services</span>
                                                        {% elseif page.path == '/tarifs' %}
                                                            <span class="font-weight-bold" style="font-size: 13px;">
                                                                Tarifs & Formules
                                                            </span>
                                                            <span class="badge bg-light text-muted ml-1" style="font-size: 10px;">/tarifs</span>
                                                        {% elseif page.path == '/contact' %}
                                                            <span class="font-weight-bold" style="font-size: 13px;">
                                                                Contact & Devis
                                                            </span>
                                                            <span class="badge bg-light text-muted ml-1" style="font-size: 10px;">/contact</span>
                                                        {% else %}
                                                            <span class="font-weight-bold font-family-monospace" style="font-size: 13px;">
                                                                {{ page.path }}
                                                            </span>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge rounded-pill font-weight-bold px-3 py-1" style="font-size: 12px;">
                                                    <i class="fas fa-eye text-primary mr-1"></i>{{ page.views }}
                                                </span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <span class="mr-2 text-xs font-weight-bold">{{ page.percentage }}%</span>
                                                    <div class="progress flex-grow-1" style="height: 6px; border-radius: 4px;">
                                                        <div class="progress-bar {% if idx == 0 %}bg-primary{% elseif idx == 1 %}bg-info{% else %}bg-secondary{% endif %}" role="progressbar" style="width: {{ page.percentage }}%;" aria-valuenow="{{ page.percentage }}" aria-valuemin="0" aria-valuemax="100"></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <a href="https://{{ tenantReport.domain }}{{ page.path }}" target="_blank" class="btn btn-sm btn-light rounded-circle shadow-sm" title="Ouvrir la page dans un nouvel onglet">
                                                    <i class="fas fa-external-link-alt text-primary" style="font-size: 11px;"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">
                                            <i class="fas fa-chart-line fa-2x mb-2 text-muted d-block"></i>
                                            En attente des premières visites sur votre site (les URLs visitées s'afficheront ici automatiquement).
                                        </td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 7-Day Visitor Trend Chart for Current Tenant -->
        <div class="col-xl-5">
            <div class="card border-0 shadow-sm rounded-lg h-100 bg-white">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-chart-area mr-2"></i>Évolution des Visiteurs (7 Derniers Jours)
                    </h6>
                </div>
                <div class="card-body">
                    <div id="tenantVisitsHistoryChart" style="min-height: 260px;"></div>
                    <div class="small text-muted text-center mt-2">
                        <i class="fas fa-info-circle mr-1"></i>Nombre de visiteurs uniques quotidiens sur <strong>{{ tenantReport.tenant_name }}</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Collapsible Multi-Tenant Comparison (Optional Network View) -->
    <div class="collapse mb-4" id="allTenantsCollapse">
        <div class="card border-0 shadow-sm rounded-lg bg-white p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="m-0 font-weight-bold text-secondary">
                    <i class="fas fa-sitemap mr-2"></i>Vue Réseau Multi-Sites (Tous les Tenants)
                </h6>
                <span class="badge bg-light text-muted">{{ trafficMetrics.tenants_details|default([])|length }} sites configurés</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-items-center table-flush mb-0 table-hover">
                    <thead class="thead-light">
                        <tr>
                            <th>Site / Tenant</th>
                            <th>Domaine</th>
                            <th class="text-center">En Direct</th>
                            <th class="text-center">Aujourd'hui</th>
                            <th class="text-center">Ce Mois</th>
                            <th>Page N°1</th>
                            <th>Part Globale</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for t in trafficMetrics.tenants_details|default([]) %}
                            <tr {% if t.code == currentTenantCode %}class="table-primary font-weight-bold"{% endif %}>
                                <td>{{ t.name }} <span class="badge bg-light text-muted">{{ t.code }}</span></td>
                                <td><a href="https://{{ t.domain }}" target="_blank" class="text-muted small"><i class="fas fa-external-link-alt mr-1"></i>{{ t.domain }}</a></td>
                                <td class="text-center">
                                    {% if t.online > 0 %}
                                        <span class="badge bg-success text-white px-2 py-1"><span class="live-dot mr-1"></span>{{ t.online }}</span>
                                    {% else %}
                                        <span class="text-muted">&mdash;</span>
                                    {% endif %}
                                </td>
                                <td class="text-center">{{ t.today_unique }}</td>
                                <td class="text-center">{{ t.month_unique }}</td>
                                <td><code>{{ t.top_page }}</code></td>
                                <td>{{ t.traffic_percentage }}%</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# ------------------ MAIN CHART & PERIOD SWITCHER ------------------ #}
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-lg bg-white">
                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center flex-wrap">
                    <h6 class="m-0 font-weight-bold text-primary">Évolution des Ventes</h6>
                    <div class="btn-group btn-group-toggle" data-toggle="buttons">
                        <button type="button" class="btn btn-outline-primary btn-sm active" id="btn7Days">7 Derniers Jours</button>
                        <button type="button" class="btn btn-outline-primary btn-sm" id="btnMonth">Ce Mois-ci</button>
                        <button type="button" class="btn btn-outline-primary btn-sm" id="btnYear">Cette Année</button>
                    </div>
                </div>
                <div class="card-body">
                    <div id="salesChart" style="min-height: 340px;"></div>
                </div>
            </div>
        </div>
    </div>

    {# ------------------ DONUT CHARTS: PAYMENTS & CARRIERS ------------------ #}
    <div class="row mb-4">
        <!-- Payments Breakdown Donut Chart -->
        <div class="col-lg-6 mb-4">
            <div class="card border-0 shadow-sm rounded-lg h-100 bg-white">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-credit-card mr-2"></i>Répartition des Modes de Paiement</h6>
                </div>
                <div class="card-body">
                    <div id="paymentsDonutChart" style="min-height: 280px;"></div>
                </div>
            </div>
        </div>

        <!-- Carrier Breakdown Donut Chart -->
        <div class="col-lg-6 mb-4">
            <div class="card border-0 shadow-sm rounded-lg h-100 bg-white">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-truck mr-2"></i>Répartition des Transporteurs & Livraisons</h6>
                </div>
                <div class="card-body">
                    <div id="carrierDonutChart" style="min-height: 280px;"></div>
                </div>
            </div>
        </div>
    </div>

    {# ------------------ RECENT ORDERS TABLE ------------------ #}
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card border-0 shadow-sm rounded-lg bg-white">
                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">Dernières Commandes</h6>
                    <a href="{{ ea_url().setController('App\\Controller\\Admin\\OrderAllCrudController') }}" class="btn btn-sm btn-light text-primary font-weight-bold">Voir toutes les commandes &rarr;</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-items-center table-flush mb-0">
                            <thead>
                                <tr>
                                    <th class="border-0">Réf. Commande</th>
                                    <th class="border-0">Client</th>
                                    <th class="border-0">Date</th>
                                    <th class="border-0">Montant</th>
                                    <th class="border-0 text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if recentOrders|length > 0 %}
                                    {% for order in recentOrders %}
                                        <tr>
                                            <td class="font-weight-bold text-primary">
                                                <i class="fas fa-receipt mr-1 text-muted"></i> {{ order.reference }}
                                            </td>
                                            <td>
                                                {% if order.userId %}
                                                    {{ order.userId.firstname|default('') }} {{ order.userId.lastname|default('') }}
                                                    <div class="small text-muted">{{ order.userId.email|default('') }}</div>
                                                {% else %}
                                                    <span class="text-muted">Client invité</span>
                                                {% endif %}
                                            </td>
                                            <td>{{ order.orderDate ? order.orderDate|date('d/m/Y H:i') : '-' }}</td>
                                            <td class="font-weight-bold">{{ (order.totalAmount / 100)|number_format(2, ',', ' ') }} $</td>
                                            <td class="text-center">
                                                <a href="{{ ea_url().setController('App\\Controller\\Admin\\OrderAllCrudController').setAction('detail').setEntityId(order.id) }}" class="btn btn-sm btn-circle btn-light" title="Voir détails">
                                                    <i class="fas fa-eye text-primary"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">
                                            <i class="fas fa-inbox fa-2x mb-2 d-block"></i> Aucune commande enregistrée pour le moment.
                                        </td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ------------------ MAINTENANCE / CACHE REDIS CARD ------------------ #}
    <div class="row">
        <div class="col-md-6 col-lg-5 col-xl-4 mb-4">
            <div class="card shadow-sm border-0 rounded-3 bg-white" style="border: 1px solid #eaedf1; border-radius: 12px;">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-3 p-3 mr-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background: rgba(220, 53, 69, 0.1); color: #dc3545; border-radius: 8px;">
                            <i class="fas fa-database fa-lg"></i>
                        </div>
                        <div>
                            <h5 class="card-title mb-0 font-weight-bold" style="color: #2c3e50;">Cache Redis</h5>
                            <span class="badge badge-success mt-1" style="font-size: 0.75rem;">redis:6379</span>
                        </div>
                    </div>
                    <p class="card-text text-muted small mb-4" style="line-height: 1.5;">
                        Permet d'effacer instantanément toutes les clés stockées dans la base Redis de l'application (équivalent à <code>docker compose exec redis redis-cli flushall</code>).
                    </p>
                    <form action="{{ path('admin_redis_flush') }}" method="POST" onsubmit="return confirm('Voulez-vous vraiment vider le cache Redis (flushall) ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_redis_flush') }}">
                        <button type="submit" class="btn btn-danger btn-block font-weight-bold py-2 shadow-sm" style="border-radius: 8px; width: 100%;">
                            <i class="fas fa-trash-alt mr-2"></i> Flush Redis (redis-cli flushall)
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>

{# ApexCharts Script #}
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        // --- DATA SERIES FOR TIME SWITCHER ---
        var data7Days = { labels: {{ labels7Days|raw }}, values: {{ values7Days|raw }} };
        var dataMonth = { labels: {{ labelsMonth|raw }}, values: {{ valuesMonth|raw }} };
        var dataYear  = { labels: {{ labelsYear|raw }},  values: {{ valuesYear|raw }} };

        // --- MAIN SALES AREA CHART ---
        var mainChartOptions = {
            series: [{
                name: 'Ventes ($)',
                data: data7Days.values
            }],
            chart: {
                type: 'area',
                height: 340,
                toolbar: { show: false }
            },
            colors: ['#4e73df'],
            fill: {
                type: 'gradient',
                gradient: {
                    shadeIntensity: 1,
                    opacityFrom: 0.45,
                    opacityTo: 0.05,
                    stops: [0, 90, 100]
                }
            },
            dataLabels: { enabled: false },
            stroke: { curve: 'smooth', width: 3 },
            xaxis: {
                categories: data7Days.labels,
                labels: { style: { colors: '#858796' } }
            },
            yaxis: {
                labels: {
                    formatter: function (val) { return val.toFixed(2) + " $"; },
                    style: { colors: '#858796' }
                }
            },
            tooltip: {
                y: { formatter: function (val) { return val.toFixed(2) + " $"; } }
            },
            grid: { borderColor: '#e3e6f0' }
        };

        var mainChart = new ApexCharts(document.querySelector("#salesChart"), mainChartOptions);
        mainChart.render();

        // TIME SWITCHER BUTTON LOGIC
        document.getElementById('btn7Days').addEventListener('click', function() {
            setActiveButton(this);
            mainChart.updateOptions({
                xaxis: { categories: data7Days.labels },
                series: [{ name: 'Ventes ($)', data: data7Days.values }]
            });
        });

        document.getElementById('btnMonth').addEventListener('click', function() {
            setActiveButton(this);
            mainChart.updateOptions({
                xaxis: { categories: dataMonth.labels },
                series: [{ name: 'Ventes ($)', data: dataMonth.values }]
            });
        });

        document.getElementById('btnYear').addEventListener('click', function() {
            setActiveButton(this);
            mainChart.updateOptions({
                xaxis: { categories: dataYear.labels },
                series: [{ name: 'Ventes ($)', data: dataYear.values }]
            });
        });

        function setActiveButton(activeBtn) {
            document.querySelectorAll('#btn7Days, #btnMonth, #btnYear').forEach(function(btn) {
                btn.classList.remove('active');
            });
            activeBtn.classList.add('active');
        }

        // --- PAYMENTS DONUT CHART ---
        var paymentOptions = {
            series: {{ paymentSeries|raw }},
            labels: {{ paymentLabels|raw }},
            chart: { type: 'donut', height: 280 },
            colors: ['#1cc88a', '#4e73df', '#36b9cc'],
            legend: { position: 'bottom' },
            dataLabels: { enabled: true }
        };
        var paymentChart = new ApexCharts(document.querySelector("#paymentsDonutChart"), paymentOptions);
        paymentChart.render();

        // --- CARRIER DONUT CHART ---
        var carrierOptions = {
            series: {{ carrierSeries|raw }},
            labels: {{ carrierLabels|raw }},
            chart: { type: 'donut', height: 280 },
            colors: ['#f6c23e', '#fd7e14', '#6f42c1'],
            legend: { position: 'bottom' },
            dataLabels: { enabled: true }
        };
        var carrierChart = new ApexCharts(document.querySelector("#carrierDonutChart"), carrierOptions);
        carrierChart.render();

        // --- CURRENT TENANT 7-DAY VISITS HISTORY CHART ---
        var historyLabels = {{ tenantReport.labels_7days|raw }};
        var historyValues = {{ tenantReport.values_7days|raw }};

        var historyOptions = {
            series: [{
                name: 'Visiteurs Uniques',
                data: historyValues
            }],
            chart: {
                type: 'area',
                height: 260,
                toolbar: { show: false },
                zoom: { enabled: false }
            },
            colors: ['#4e73df'],
            fill: {
                type: 'gradient',
                gradient: {
                    shadeIntensity: 1,
                    opacityFrom: 0.45,
                    opacityTo: 0.05,
                    stops: [20, 100]
                }
            },
            dataLabels: { enabled: false },
            stroke: { curve: 'smooth', width: 3 },
            xaxis: {
                categories: historyLabels,
                labels: { style: { colors: '#858796' } },
                axisBorder: { show: false }
            },
            yaxis: {
                min: 0,
                forceNiceScale: true,
                labels: {
                    formatter: function(val) { return Math.round(val); },
                    style: { colors: '#858796' }
                }
            },
            tooltip: {
                y: {
                    formatter: function(val) { return val + " visiteur(s)"; }
                }
            },
            grid: { borderColor: '#e3e6f0' }
        };
        var historyChart = new ApexCharts(document.querySelector("#tenantVisitsHistoryChart"), historyOptions);
        historyChart.render();
    });
</script>
<style>
    @keyframes pulseLive {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(40, 167, 69, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(40, 167, 69, 0); }
    }
    .live-dot {
        width: 8px;
        height: 8px;
        background-color: #28a745;
        border-radius: 50%;
        display: inline-block;
        animation: pulseLive 2s infinite;
        vertical-align: middle;
    }
    .bg-success-soft {
        background-color: rgba(40, 167, 69, 0.12) !important;
    }
</style>
{% endblock %}
