{# Onglet « Plateforme » de la console de pilotage (PlatformConsoleAdminController, lot 4, 04/11/2026). Habillage EasyAdmin depuis le menu ; ea() dit s'il y a un contexte. #}
{% extends ea() is not null ? '@EasyAdmin/page/content.html.twig' : 'base_admin.html.twig' %}

{% block title %}Plateforme : pilotage des fonctionnalités{% endblock %}
{% block content_title %}Plateforme : pilotage des fonctionnalités{% endblock %}

{% block main %}{{ block('plateforme_panel') }}{% endblock %}
{% block body %}{% if ea() is null %}
    <div class="container-fluid py-3">
        <h1 class="h3 mb-3">Plateforme : pilotage des fonctionnalités</h1>
        {{ block('plateforme_panel') }}
    </div>
{% else %}{{ parent() }}{% endif %}{% endblock %}

{% macro badge(e) %}
    {% if e.enabled %}
        {% set cls = e.status == 'grace' ? 'bg-warning text-dark' : (e.source == 'trial' ? 'bg-info text-dark' : 'bg-success') %}
        <span class="badge {{ cls }}" title="droit n° {{ e.id }}">{{ e.source }}{% if e.status == 'grace' %} (grâce){% endif %}</span>
        {% if e.endsAt %}<div class="small text-muted">→ {{ e.endsAt|slice(0, 10) }}</div>{% endif %}
    {% else %}
        <span class="badge bg-light text-muted border">non</span>
    {% endif %}
{% endmacro %}
{% import _self as m %}

{% block plateforme_panel %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}<div class="alert alert-{{ label }}">{{ message }}</div>{% endfor %}
    {% endfor %}

    <p class="mb-3"><a class="btn btn-sm btn-outline-dark" href="{{ incidentsUrl ?? path('admin_plateforme_incidents') }}">Incidents de la plateforme</a></p>

    <div class="card mb-3 plateforme-mode">
        <div class="card-body d-flex flex-wrap align-items-center gap-3">
            <div>
                <strong>Mode de la plateforme :</strong>
                {% if mode.mode == 'live' %}<span class="badge bg-danger">live</span> <span class="text-muted small">les garde-fous des modules et des droits d'usage s'appliquent</span>
                {% else %}<span class="badge bg-secondary">demo</span> <span class="text-muted small">aucune restriction : tout est visible et réglable, rien n'est bloqué</span>{% endif %}
                {% if mode.updatedAt %}<div class="small text-muted">changé le {{ mode.updatedAt|slice(0, 16) }} par {{ mode.updatedBy ?? 'inconnu' }}</div>{% endif %}
            </div>
            <form method="post" action="{{ path('admin_plateforme_shop') }}" class="d-flex gap-2 align-items-end plateforme-boutique">
                <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
                <div><label class="form-label small mb-0" for="pf-shop-tenant">Site de la boutique de forfaits</label>
                    <select class="form-select form-select-sm" id="pf-shop-tenant" name="shopTenant" style="width:14em" title="le seul site dont les formules branchées produisent des droits"><option value="">— aucun —</option>{% for s in sites %}<option value="{{ s.code }}" {{ mode.shopTenant == s.code ? 'selected' : '' }}>{{ s.code }}</option>{% endfor %}</select></div>
                <div><label class="form-label small mb-0" for="pf-shop">Adresse de la boutique (forfaits)</label>
                    <input class="form-control form-control-sm" id="pf-shop" name="shopUrl" type="url" style="width:22em" value="{{ mode.shopUrl ?? '' }}" placeholder="https://… (vide : pas encore de boutique)"></div>
                <button type="submit" class="btn btn-sm btn-outline-primary">Enregistrer</button>
            </form>
            <form method="post" action="{{ path('admin_plateforme_mode') }}" class="ms-auto">
                <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
                <input type="hidden" name="mode" value="{{ mode.mode == 'live' ? 'demo' : 'live' }}">
                <button type="submit" class="btn btn-sm {{ mode.mode == 'live' ? 'btn-outline-secondary' : 'btn-outline-danger' }}" onclick="return confirm('Passer la plateforme en mode {{ mode.mode == 'live' ? 'demo' : 'live' }} ?')">Passer en {{ mode.mode == 'live' ? 'demo' : 'live' }}</button>
            </form>
        </div>
    </div>

    <h2 class="h5 mt-3">Sites et fonctionnalités</h2>
    <p class="text-muted small">Source du droit : manual (accordé à la main), trial (essai, avec sa fin), free (gratuit sans fin), subscription (abonnement de la boutique de la plateforme). Cliquer un site pour son détail et son journal.</p>
    <div class="table-responsive">
    <table class="table table-sm datagrid plateforme-grille">
        <thead><tr><th>Site</th>{% for f in features %}<th class="text-center small">{{ labels[f] }}</th>{% endfor %}<th>Demandes</th><th>Préparation</th></tr></thead>
        <tbody>
        {% for s in sites %}
            <tr data-site="{{ s.code }}" class="{{ s.code == selected ? 'table-active' : '' }}">
                <td><a href="{{ siteUrls[s.code] ?? path('admin_plateforme', {site: s.code}) }}"><strong>{{ s.code }}</strong></a><div class="small text-muted">{{ s.name }}</div></td>
                {% for f in features %}<td class="text-center">{{ m.badge(s.features[f]) }}</td>{% endfor %}
                <td>{% for r in s.pendingRequests %}<span class="badge bg-warning text-dark">{{ labels[r] ?? r }}</span> {% endfor %}</td>
                <td class="small" style="min-width: 11em"><div class="progress" style="height: 6px" title="{{ s.readiness.done }} / {{ s.readiness.total }}"><div class="progress-bar {{ s.readiness.percent >= 100 ? 'bg-success' : '' }}" style="width: {{ s.readiness.percent }}%"></div></div>{{ s.readiness.percent }} %{% if s.readiness.next %} · <span class="text-muted">{{ s.readiness.next.title }}</span>{% endif %}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>

    <h2 class="h5 mt-4">Accorder un droit</h2>
    <form method="post" action="{{ path('admin_plateforme_grant') }}" class="row g-2 align-items-end plateforme-accorder">
        <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
        <div class="col-md-3"><label class="form-label" for="g-site">Site</label>
            <select class="form-select" id="g-site" name="tenant" required>{% for s in sites %}<option value="{{ s.code }}" {{ s.code == selected ? 'selected' : '' }}>{{ s.code }} — {{ s.name }}</option>{% endfor %}</select></div>
        <div class="col-md-3"><label class="form-label" for="g-feature">Fonctionnalité</label>
            <select class="form-select" id="g-feature" name="feature" required>{% for f in features %}<option value="{{ f }}">{{ labels[f] }}</option>{% endfor %}</select></div>
        <div class="col-md-2"><label class="form-label" for="g-source">Source</label>
            <select class="form-select" id="g-source" name="source"><option value="manual">manual (sans fin)</option><option value="trial">trial (essai)</option><option value="free">free (gratuit)</option></select></div>
        <div class="col-md-1"><label class="form-label" for="g-days">Jours</label><input class="form-control" id="g-days" name="days" type="number" min="1" max="730" placeholder="essai"></div>
        <div class="col-md-2"><label class="form-label" for="g-note">Note</label><input class="form-control" id="g-note" name="note" maxlength="500"></div>
        <div class="col-md-1"><button type="submit" class="btn btn-primary w-100">Accorder</button></div>
        <input type="hidden" name="site" value="{{ selected }}">
    </form>

    {% if selected %}
        {% set site = null %}{% for s in sites %}{% if s.code == selected %}{% set site = s %}{% endif %}{% endfor %}
        {% if site %}
        <h2 class="h5 mt-4">Droits de {{ site.code }}</h2>
        <table class="table table-sm datagrid plateforme-droits">
            <thead><tr><th>Fonctionnalité</th><th>Droit</th><th>Statut</th><th>Fin</th><th>Actions</th></tr></thead>
            <tbody>
            {% for f in features %}{% set e = site.features[f] %}
                <tr>
                    <td>{{ labels[f] }}</td>
                    <td>{% if e.enabled %}n° {{ e.id }} · {{ e.source }}{% if e.offerCode %} · offre {{ e.offerCode }}{% endif %}{% else %}<span class="text-muted">aucun</span>{% endif %}</td>
                    <td>{{ e.enabled ? e.status : '—' }}</td>
                    <td>{{ e.endsAt ? e.endsAt|slice(0, 10) : (e.enabled ? 'sans fin' : '—') }}</td>
                    <td>
                        {% if e.enabled %}
                            <form method="post" action="{{ path('admin_plateforme_act', {id: e.id, action: 'suspend'}) }}" class="d-inline"><input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}"><input type="hidden" name="site" value="{{ site.code }}"><button class="btn btn-sm btn-outline-warning">Suspendre</button></form>
                            {% if e.source == 'subscription' %}
                                <div class="small text-warning">Ce module est payé par un abonnement{% if e.offerCode %} (offre {{ e.offerCode }}){% endif %} : retiré seul, il se rallumera au renouvellement.</div>
                                <form method="post" action="{{ path('admin_plateforme_act', {id: e.id, action: 'cancel'}) }}" class="d-inline"><input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}"><input type="hidden" name="site" value="{{ site.code }}"><input type="hidden" name="resilier" value="1"><button class="btn btn-sm btn-danger" onclick="return confirm({{ 'Retirer ce droit et résilier TOUT l’abonnement à la fin de la période payée ? Toutes les fonctionnalités de son offre s’éteindront alors.'|json_encode|e('html_attr') }})">Retirer et résilier</button></form>
                            {% endif %}
                            <form method="post" action="{{ path('admin_plateforme_act', {id: e.id, action: 'cancel'}) }}" class="d-inline"><input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}"><input type="hidden" name="site" value="{{ site.code }}"><button class="btn btn-sm btn-outline-danger" onclick="return confirm({{ (e.source == 'subscription' ? 'Retirer ce droit SANS résilier l’abonnement ? Il se rallumera au renouvellement.' : 'Retirer ce droit ?')|json_encode|e('html_attr') }})">Retirer</button></form>
                            <form method="post" action="{{ path('admin_plateforme_act', {id: e.id, action: 'extend'}) }}" class="d-inline-flex gap-1"><input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}"><input type="hidden" name="site" value="{{ site.code }}"><input type="date" name="endsAt" class="form-control form-control-sm" style="width:10em" title="vide = sans fin"><button class="btn btn-sm btn-outline-primary">Prolonger</button></form>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
    {% endif %}

    <h2 class="h5 mt-4">Demandes des sites{% if requests is not empty %} <span class="badge bg-warning text-dark">{{ requests|length }}</span>{% endif %}</h2>
    {% if requests is empty %}<p class="text-muted">Aucune demande en attente.</p>{% else %}
    <table class="table table-sm datagrid plateforme-demandes">
        <thead><tr><th>Site</th><th>Fonctionnalité</th><th>Par</th><th>Message</th><th>Le</th><th>Décision</th></tr></thead>
        <tbody>
        {% for r in requests %}
            <tr>
                <td>{{ r.tenant_code }}</td><td>{{ labels[r.feature_key] ?? r.feature_key }}</td><td>{{ r.requested_by }}</td><td>{{ r.message }}</td><td>{{ r.created_at|slice(0, 16) }}</td>
                <td>
                    <form method="post" action="{{ path('admin_plateforme_request', {id: r.id, decision: 'grant'}) }}" class="d-inline-flex gap-1"><input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
                        <select name="source" class="form-select form-select-sm" style="width:9em"><option value="trial">essai</option><option value="manual">manuel</option><option value="free">gratuit</option></select>
                        <input type="number" name="days" class="form-control form-control-sm" style="width:5em" min="1" max="730" placeholder="jours">
                        <button class="btn btn-sm btn-success">Accorder</button></form>
                    <form method="post" action="{{ path('admin_plateforme_request', {id: r.id, decision: 'refuse'}) }}" class="d-inline"><input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}"><button class="btn btn-sm btn-outline-secondary">Refuser</button></form>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% endif %}

    <h2 class="h5 mt-4">Politiques par fonctionnalité</h2>
    <table class="table table-sm datagrid plateforme-politiques">
        <thead><tr><th>Fonctionnalité</th><th>Essai autorisé</th><th>Jours d'essai</th><th>Gratuité autorisée</th><th>Grâce (jours)</th><th></th></tr></thead>
        <tbody>
        {% for f in features %}{% set p = policies[f] %}
            <tr>
                <form method="post" action="{{ path('admin_plateforme_policy', {feature: f}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
                <td>{{ labels[f] }}</td>
                <td><input type="checkbox" name="trialAllowed" value="1" {{ p.trial_allowed ? 'checked' : '' }}></td>
                <td><input type="number" name="trialDays" class="form-control form-control-sm" style="width:6em" min="1" max="730" value="{{ p.trial_days }}"></td>
                <td><input type="checkbox" name="freeAllowed" value="1" {{ p.free_allowed ? 'checked' : '' }}></td>
                <td><input type="number" name="graceDays" class="form-control form-control-sm" style="width:6em" min="0" max="90" value="{{ p.grace_days }}"></td>
                <td><button class="btn btn-sm btn-outline-primary">Enregistrer</button></td>
                </form>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <h2 class="h5 mt-4" id="livraison">Étiquettes par la plateforme</h2>
    <p class="text-muted small">Lot 2 Livraison (07/11/2026) : un site en mode « par la plateforme » achète ses étiquettes avec la clé EasyPost de la plateforme et un <strong>solde prépayé</strong>. Frais de service ajoutés au coût EasyPost ; comptes transporteurs de la clé de la plateforme (un par ligne : <code>ca_…|CanadaPost|Postes Canada</code>), à propager dans gmasuite et les sites en mode plateforme.</p>
    <div class="row g-3">
        <div class="col-lg-6">
            <form method="post" action="{{ path('admin_plateforme_shipping_fees') }}" class="card plateforme-livraison-frais"><div class="card-body">
                <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
                <div class="row g-2">
                    <div class="col-6"><label class="form-label" for="sf-percent">Marge (%)</label><input class="form-control" id="sf-percent" name="feePercent" value="{{ (shippingSettings.feeBp / 100)|number_format(2, '.', '') }}" inputmode="decimal"></div>
                    <div class="col-6"><label class="form-label" for="sf-fixed">Frais fixes par étiquette (CAD)</label><input class="form-control" id="sf-fixed" name="feeFixed" value="{{ (shippingSettings.feeFixedCents / 100)|number_format(2, '.', '') }}" inputmode="decimal"></div>
                    <div class="col-12"><label class="form-label" for="sf-carriers">Comptes transporteurs de la plateforme</label><textarea class="form-control" id="sf-carriers" name="carriers" rows="4" placeholder="ca_xxxxxxxx|CanadaPost|Postes Canada">{% for c in shippingSettings.carriers %}{{ c.id }}|{{ c.carrier }}|{{ c.label }}
{% endfor %}</textarea></div>
                </div>
                <button type="submit" class="btn btn-sm btn-primary mt-2">Enregistrer</button>
            </div></form>
        </div>
        <div class="col-lg-6">
            <div class="card"><div class="card-body">
                <h3 class="h6">Soldes prépayés</h3>
                <table class="table table-sm mb-2 plateforme-soldes"><thead><tr><th>Site</th><th class="text-end">Solde</th></tr></thead><tbody>
                {% for b in shippingBalances %}<tr><td>{{ b.tenantCode }}</td><td class="text-end">{{ (b.balanceCents / 100)|number_format(2, ',', ' ') }} {{ b.currency }}</td></tr>{% else %}<tr><td colspan="2" class="text-muted">Aucun solde encore.</td></tr>{% endfor %}
                </tbody></table>
                <form method="post" action="{{ path('admin_plateforme_shipping_credit') }}" class="row g-2 align-items-end plateforme-crediter">
                    <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
                    <div class="col-5"><label class="form-label" for="sc-site">Site</label><select class="form-select form-select-sm" id="sc-site" name="tenant">{% for s in sites %}<option value="{{ s.code }}" {{ s.code == selected ? 'selected' : '' }}>{{ s.code }}</option>{% endfor %}</select></div>
                    <div class="col-3"><label class="form-label" for="sc-amount">Montant (CAD)</label><input class="form-control form-control-sm" id="sc-amount" name="amount" inputmode="decimal" placeholder="50"></div>
                    <div class="col-4"><label class="form-label" for="sc-note">Note</label><input class="form-control form-control-sm" id="sc-note" name="note" maxlength="200"></div>
                    <div class="col-12"><button type="submit" class="btn btn-sm btn-outline-primary">Créditer</button></div>
                </form>
            </div></div>
        </div>
    </div>

    <h2 class="h5 mt-4" id="ia-credits">Crédits IA par site</h2>
    <p class="text-muted small">Chaque appel à l'IA d'un site (assistant, pages, fiches produit, poids, lots) consomme ses crédits du mois ; à zéro, l'IA refuse. Seul le propriétaire de la plateforme règle ces crédits : l'administrateur du site les voit, et il est invité à acheter des crédits ou à changer de forfait quand il en reste peu. Les quotas IA de Mémoires Vivantes sont à part (par jour, page dédiée).</p>
    <div class="card plateforme-ia-credits"><div class="card-body">
        <form method="post" action="{{ path('admin_plateforme_ai_defaults') }}" class="row g-2 align-items-end mb-3" data-ai-defaults><input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
            <div class="col-auto"><label class="form-label small mb-0">Crédits par mois des sites sans réglage</label><input class="form-control form-control-sm" type="number" min="0" max="100000" name="defaultCredits" value="{{ aiDefaults.aiDefaultCredits }}" style="width: 8em"></div>
            <div class="col-auto"><label class="form-label small mb-0">Essai « Aide IA » à la création (jours, 0 = aucun)</label><input class="form-control form-control-sm" type="number" min="0" max="365" name="trialDays" value="{{ aiDefaults.aiTrialDays }}" style="width: 8em"></div>
            <div class="col-auto"><button class="btn btn-sm btn-outline-primary">Enregistrer</button></div>
            <div class="col-12 form-text">L'assistant suit toujours les services « Aide IA » et « IA complète » accordés au site, même en mode démonstration ; un nouveau site reçoit l'essai ci-dessus, puis demande ou prend un forfait. Vous gardez l'accès complet partout.</div>
        </form>
        <table class="table table-sm mb-2"><thead><tr><th>Site</th><th class="text-end">Crédits / mois</th><th class="text-end">Utilisés</th><th class="text-end">Restants</th><th></th></tr></thead><tbody>
        {% for c in aiCredits %}<tr data-ai-credits-site="{{ c.code }}"><td>{{ c.code }} <span class="text-muted small">{{ c.name }}</span></td><td class="text-end">{{ c.monthly }}{% if not c.hasSetting %} <span class="text-muted small">(défaut)</span>{% endif %}</td><td class="text-end">{{ c.used }}</td><td class="text-end {{ c.monthly > 0 and c.remaining * 5 <= c.monthly ? 'text-danger fw-bold' : '' }}">{{ c.remaining }}</td>
            <td><form method="post" action="{{ path('admin_plateforme_ai_credits') }}" class="d-flex gap-1 justify-content-end"><input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}"><input type="hidden" name="tenant" value="{{ c.code }}"><input class="form-control form-control-sm" style="max-width: 7em" type="number" min="0" max="100000" name="monthly" value="{{ c.monthly }}"><button class="btn btn-sm btn-outline-primary">Régler</button></form></td></tr>
        {% else %}<tr><td colspan="5" class="text-muted">Aucun site.</td></tr>{% endfor %}
        </tbody></table>
    </div></div>

    <h2 class="h5 mt-4">Offres et prix</h2>
    <p class="text-muted small">Prix mensuels par défaut provisoires (04/11/2026). Une offre réunit une ou plusieurs fonctionnalités ; la boutique de la plateforme vendra ces offres comme formules d'abonnement branchées (code de l'offre dans la formule).</p>
    <table class="table table-sm datagrid plateforme-offres">
        <thead><tr><th>Code</th><th>Offre</th><th>Fonctionnalités</th><th>Mensuel</th><th>Annuel</th><th>Essai (j)</th><th>Active</th><th></th></tr></thead>
        <tbody>
        {% for o in offers %}
            <tr>
                <form method="post" action="{{ path('admin_plateforme_offer', {code: o.code}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
                <td><code>{{ o.code }}</code></td>
                <td>{{ o.labelFr }}<div class="small text-muted">{{ o.labelEn }}</div></td>
                <td class="small">{% for f in o.features %}{{ labels[f] ?? f }}{% if not loop.last %}, {% endif %}{% endfor %}</td>
                <td><div class="input-group input-group-sm" style="width:9em"><input type="text" name="monthlyPrice" class="form-control" value="{{ (o.monthlyPriceCents / 100)|number_format(2, '.', '') }}"><span class="input-group-text">{{ o.currency }}</span></div></td>
                <td><input type="text" name="yearlyPrice" class="form-control form-control-sm" style="width:7em" value="{{ o.yearlyPriceCents is not null ? (o.yearlyPriceCents / 100)|number_format(2, '.', '') : '' }}" placeholder="—"></td>
                <td><input type="number" name="trialDays" class="form-control form-control-sm" style="width:5em" min="0" max="365" value="{{ o.trialDays }}"></td>
                <td><input type="checkbox" name="isActive" value="1" {{ o.isActive ? 'checked' : '' }}></td>
                <td><button class="btn btn-sm btn-outline-primary">Enregistrer</button></td>
                </form>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {# Lot L6-a (17/11/2026) : le matériel de la prévention des pertes, vendu dans la boutique de forfaits (docs/prevention-pertes.md § 19.4) #}
    <h2 class="h5 mt-4" id="materiel-pertes">Matériel de la prévention des pertes</h2>
    <p class="text-muted small">Prix et lien de la fiche dans la boutique de forfaits. Un article n'est montré aux sites (gamme de matériel, bouton « Acheter » du web) que mis en vente, avec un prix. Rien n'est en vente au départ. Le mobile ne montre ni prix ni lien d'achat.</p>
    <table class="table table-sm datagrid plateforme-materiel">
        <thead><tr><th>Code</th><th>Article</th><th>Niveau</th><th>Prix</th><th>Lien de la fiche (https)</th><th>En vente</th><th></th></tr></thead>
        <tbody>
        {% for h in lossHardware %}
            <tr>
                <form method="post" action="{{ path('admin_plateforme_loss_hardware', {code: h.code}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
                <td><code>{{ h.code }}</code></td>
                <td>{{ h.labelFr }}<div class="small text-muted">{{ h.labelEn }}</div></td>
                <td>{{ h.level }}</td>
                <td><div class="input-group input-group-sm" style="width:9em"><input type="text" name="price" class="form-control" value="{{ h.priceCents is not null ? (h.priceCents / 100)|number_format(2, '.', '') : '' }}" placeholder="—"><span class="input-group-text">{{ h.currency }}</span></div></td>
                <td><input type="url" name="buyUrl" class="form-control form-control-sm" style="min-width:18em" value="{{ h.buyUrl ?? '' }}" placeholder="https://"></td>
                <td><input type="checkbox" name="isActive" value="1" {{ h.isActive ? 'checked' : '' }}></td>
                <td><button class="btn btn-sm btn-outline-primary">Enregistrer</button></td>
                </form>
            </tr>
        {% else %}
            <tr><td colspan="7" class="text-muted">Aucun article : la table du matériel n'est pas posée sur la base maître.</td></tr>
        {% endfor %}
        </tbody>
    </table>

    <h2 class="h5 mt-4" id="expeditions-pertes">Boîtiers à expédier</h2>
    <p class="text-muted small">Préparer : brancher le boîtier une fois à l'entrepôt (il dépose sa demande), le débrancher. Puis réserver pour UN site : son numéro de série et le code de son étiquette (lu au QR). Au premier branchement dans la boutique, l'administrateur du site reçoit « Votre boîtier est branché » et confirme dans les 72 heures. Vérifiez le site dans l'aperçu avant de confirmer.</p>
    {% if lossShipmentPreview %}
        <div class="alert alert-warning">
            <strong>Aperçu, rien n'est écrit.</strong> Boîtier <code>{{ lossShipmentPreview.serial }}</code> pour le site
            <strong>{{ lossShipmentPreview.site.name }}</strong> (<code>{{ lossShipmentPreview.site.code }}</code>{% if lossShipmentPreview.site.host %}, {{ lossShipmentPreview.site.host }}{% endif %}),
            module des pertes : oui{% if lossShipmentPreview.orderRef %}, commande {{ lossShipmentPreview.orderRef }}{% endif %} ; boîtier préparé (sa demande est déposée). L'avis partira à son premier branchement dans la boutique, pas avant.
            <form method="post" action="{{ path('admin_plateforme_loss_shipment') }}" class="mt-2">
                <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
                <input type="hidden" name="step" value="confirmer">
                {% for k, v in lossShipmentPreview.input %}<input type="hidden" name="{{ k }}" value="{{ v }}">{% endfor %}
                <label class="form-label small">Relisez le code de l'étiquette de CE boîtier (QR) pour confirmer</label>
                <input type="text" name="code" class="form-control form-control-sm d-inline-block" style="width:12em" required autocomplete="off">
                <button class="btn btn-sm btn-primary">Confirmer la réservation</button>
            </form>
        </div>
    {% endif %}
    <form method="post" action="{{ path('admin_plateforme_loss_shipment') }}" class="row g-2 align-items-end mb-3">
        <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
        <input type="hidden" name="step" value="apercu">
        <div class="col-auto"><label class="form-label small">Numéro de série</label><input type="text" name="serial" class="form-control form-control-sm" required></div>
        <div class="col-auto"><label class="form-label small">Code de l'étiquette</label><input type="text" name="code" class="form-control form-control-sm" placeholder="KX7-42P-9QM" required autocomplete="off"></div>
        <div class="col-auto"><label class="form-label small">Site (code)</label><input type="text" name="tenantCode" class="form-control form-control-sm" required></div>
        <div class="col-auto"><label class="form-label small">Commande</label><input type="text" name="orderRef" class="form-control form-control-sm" maxlength="80"></div>
        <div class="col-auto"><button class="btn btn-sm btn-outline-primary">Aperçu</button></div>
    </form>
    <table class="table table-sm datagrid plateforme-expeditions">
        <thead><tr><th>N°</th><th>Série</th><th>Site</th><th>Commande</th><th>État</th><th>Branché</th><th>Confirmé</th><th></th></tr></thead>
        <tbody>
        {% for e in lossShipments %}
            <tr>
                <td>{{ e.id }}</td><td><code>{{ e.serial }}</code></td><td><code>{{ e.tenantCode }}</code></td><td>{{ e.orderRef }}</td>
                <td>{{ {reserved: 'réservé', plugged: 'branché, à confirmer', confirmed: 'confirmé', cancelled: 'annulé'}[e.status] ?? e.status }}</td>
                <td class="small">{{ e.pluggedAt ?? '—' }}</td><td class="small">{{ e.confirmedAt ?? '—' }}</td>
                <td>{% if e.status in ['reserved', 'plugged'] %}
                    <form method="post" action="{{ path('admin_plateforme_loss_shipment_code', {id: e.id}) }}" class="d-inline-flex gap-1 mb-1">
                        <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
                        <input type="text" name="code" class="form-control form-control-sm" style="width:9em" placeholder="code relu" required autocomplete="off">
                        <button class="btn btn-sm btn-outline-secondary">Renvoyer le code</button>
                    </form>
                    <form method="post" action="{{ path('admin_plateforme_loss_shipment_cancel', {id: e.id}) }}" onsubmit="return confirm('Annuler cette expédition ? Son code sera libéré.');">
                        <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}"><button class="btn btn-sm btn-outline-danger">Annuler</button>
                    </form>{% endif %}</td>
            </tr>
        {% else %}
            <tr><td colspan="8" class="text-muted">Aucune expédition.</td></tr>
        {% endfor %}
        </tbody>
    </table>

    <h2 class="h5 mt-4">Journal{% if selected %} de {{ selected }}{% endif %}</h2>
    <table class="table table-sm datagrid plateforme-journal">
        <thead><tr><th>Le</th><th>Site</th><th>Fonctionnalité</th><th>Événement</th><th>Détail</th></tr></thead>
        <tbody>
        {% for e in events %}
            <tr><td>{{ e.created_at|slice(0, 16) }}</td><td>{{ e.tenant_code }}</td><td>{{ labels[e.feature_key] ?? e.feature_key }}</td><td><span class="badge bg-light text-dark border">{{ e.event }}</span></td><td class="small text-muted">{{ e.payload }}</td></tr>
        {% else %}
            <tr><td colspan="5" class="text-muted">Aucun événement.</td></tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
