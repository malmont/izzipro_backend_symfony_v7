{# Incidents de la plateforme (PlatformIncidentsAdminController, lot INC-1a, 18/11/2026), super administrateur seul. Habillage EasyAdmin depuis le menu ; ea() dit s'il y a un contexte. #}
{% extends ea() is not null ? '@EasyAdmin/page/content.html.twig' : 'base_admin.html.twig' %}

{% block title %}Plateforme : incidents{% endblock %}
{% block content_title %}Plateforme : incidents{% endblock %}

{% block main %}{{ block('incidents_panel') }}{% endblock %}
{% block body %}{% if ea() is null %}
    <div class="container-fluid py-3">
        <h1 class="h3 mb-3">Plateforme : incidents</h1>
        {{ block('incidents_panel') }}
    </div>
{% else %}{{ parent() }}{% endif %}{% endblock %}

{% block incidents_panel %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}<div class="alert alert-{{ label }}">{{ message }}</div>{% endfor %}
    {% endfor %}
    <p class="mb-3"><a href="{{ backUrl }}">← Plateforme</a></p>

    <form method="get" class="row g-2 align-items-end mb-3">
        {% for key, choices in {status: statuses, app: apps, level: levels} %}
            <div class="col-auto">
                <label class="form-label small mb-0">{{ {status: 'État', app: 'Application', level: 'Gravité'}[key] }}</label>
                <select name="{{ key }}" class="form-select form-select-sm">
                    <option value="">tous</option>
                    {% for c in choices %}<option value="{{ c }}" {{ filters[key] == c ? 'selected' }}>{{ c }}</option>{% endfor %}
                </select>
            </div>
        {% endfor %}
        <div class="col-auto">
            <label class="form-label small mb-0">Site</label>
            <input name="tenant" value="{{ filters.tenant }}" class="form-control form-control-sm" maxlength="50">
        </div>
        <div class="col-auto"><button class="btn btn-sm btn-primary">Filtrer</button></div>
    </form>

    <p class="small text-muted">{{ result.total }} incident(s). Messages et contextes masqués à l'écriture : aucune donnée personnelle.</p>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead><tr><th>Dernière fois</th><th>Site</th><th>Application</th><th>Gravité</th><th>Message</th><th>Fois</th><th>État</th><th></th></tr></thead>
            <tbody>
            {% for i in result.incidents %}
                <tr class="{{ i.status == 'new' ? 'table-warning' }}">
                    <td class="small">{{ i.lastSeenAt|slice(0, 16)|replace({'T': ' '}) }}</td>
                    <td>{{ i.tenantCode ?? '—' }}</td>
                    <td>{{ i.app }}{% if i.appVersion %} <span class="small text-muted">{{ i.appVersion }}</span>{% endif %}</td>
                    <td>{{ i.level }}</td>
                    <td><div>{{ i.message }}</div><div class="small text-muted">{{ i.screen ?? i.route }}</div>
                        {% if i.context %}<details class="small"><summary>contexte</summary><pre class="mb-0">{{ i.context|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES')) }}</pre></details>{% endif %}
                        {% if i.note %}<div class="small">Note : {{ i.note }}</div>{% endif %}
                        {% if i.externalUrl %}<div class="small"><a href="{{ i.externalUrl }}" rel="noopener noreferrer" target="_blank">lien externe</a></div>{% endif %}</td>
                    <td>{{ i.count }}</td>
                    <td>{{ i.status }}{% if i.reopened %} <span class="badge bg-danger">revenu</span>{% endif %}{% if i.fixedIn %}<div class="small text-muted">{{ i.fixedIn }}</div>{% endif %}</td>
                    <td>
                        <form method="post" action="{{ path('admin_plateforme_incident', {id: i.id}) }}" class="d-flex flex-column gap-1">
                            <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
                            <select name="status" class="form-select form-select-sm">
                                {% for s in statuses %}<option value="{{ s }}" {{ i.status == s ? 'selected' }}>{{ {new: 'nouveau', acknowledged: 'pris en charge', fixed: 'corrigé', ignored: 'ignoré'}[s] }}</option>{% endfor %}
                            </select>
                            <input name="fixedIn" value="{{ i.fixedIn }}" placeholder="corrigé dans (commit, version)" class="form-control form-control-sm" maxlength="80">
                            <input name="externalUrl" value="{{ i.externalUrl }}" placeholder="lien externe (https://…)" class="form-control form-control-sm" maxlength="500">
                            <input name="note" value="{{ i.note }}" placeholder="note interne" class="form-control form-control-sm" maxlength="2000">
                            <button class="btn btn-sm btn-outline-primary">Enregistrer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="8" class="text-muted">Aucun incident.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% if result.total > result.limit %}
        <nav class="small">
            {% if result.page > 1 %}<a href="{{ pageUrls.previous }}">← précédents</a>{% endif %}
            {% if result.page * result.limit < result.total %} <a href="{{ pageUrls.next }}">suivants →</a>{% endif %}
        </nav>
    {% endif %}
{% endblock %}
