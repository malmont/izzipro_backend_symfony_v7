{# Panneau « À quoi sert cet écran » (08/11/2026) : illustration et explication d'un composant du site #}
<aside class="card shadow-sm" style="flex: 0 0 340px; width: 340px; max-width: 100%; position: sticky; top: 1rem; align-self: flex-start" data-component-guide="{{ guide.key }}">
    <div class="card-body">
        <div class="text-xs text-uppercase text-muted mb-1">À quoi ça ressemble sur le site</div>
        <div class="rounded p-2 mb-3" style="background: rgba(127, 127, 127, .08); border: 1px solid rgba(127, 127, 127, .25)" data-guide-illustration>
            {{ include('admin/guide/svg/' ~ guide.svg ~ '.html.twig') }}
        </div>
        <h2 class="h6 mb-2">{{ guide.title }}</h2>
        <p class="small mb-2">{{ guide.purpose }}</p>
        <p class="small mb-2"><strong>Où :</strong> {{ guide.where }}</p>
        <div class="small"><strong>Quoi remplir :</strong>
            <ul class="mb-2 ps-3">{% for f in guide.fields %}<li>{{ f }}</li>{% endfor %}</ul>
        </div>
        {% if guide.tip is defined %}<p class="small text-muted mb-0"><i class="fas fa-lightbulb"></i> {{ guide.tip }}</p>{% endif %}
        {% if demo is defined and demo and demo.count > 0 %}
            {# Contenu d'exemple (lot 3, 08/11/2026) : fourni à la création du site, à remplacer ou à effacer #}
            <div class="mt-3 p-2 rounded" style="background: rgba(246, 194, 62, .12); border: 1px solid rgba(246, 194, 62, .5)" data-demo-content-panel data-count="{{ demo.count }}">
                <div class="small mb-2"><strong>{{ demo.count }} contenu(s) d'exemple</strong> fourni(s) avec le site, marqué(s) « exemple à remplacer » dans la liste. Modifiez-en un : il devient le vôtre. Ou effacez-les tous.</div>
                <form method="post" action="{{ demo.deleteUrl }}" onsubmit="return confirm('Effacer le contenu d\'exemple de cet écran ? Les fiches dont une fiche du site se sert sont gardées.')">
                    <input type="hidden" name="_token" value="{{ csrf_token('demo_content') }}">
                    <button class="btn btn-sm btn-outline-warning" type="submit">Effacer le contenu d'exemple de cet écran</button>
                </form>
            </div>
        {% endif %}
    </div>
</aside>
