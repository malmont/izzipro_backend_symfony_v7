{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Tableau de bord{% endblock %}

{% block main %}
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-6 col-lg-5 col-xl-4 mb-4">
            <div class="card shadow-sm border-0 rounded-3" style="background: #ffffff; border-radius: 12px; border: 1px solid #eaedf1;">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-3 p-3 me-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background: rgba(220, 53, 69, 0.1); color: #dc3545;">
                            <i class="fas fa-database fa-lg"></i>
                        </div>
                        <div>
                            <h5 class="card-title mb-0 fw-bold" style="color: #2c3e50;">Cache Redis</h5>
                            <span class="badge bg-success mt-1" style="font-size: 0.75rem;">redis:6379</span>
                        </div>
                    </div>
                    <p class="card-text text-muted small mb-4" style="line-height: 1.5;">
                        Permet d'effacer instantanément toutes les clés stockées dans la base Redis de l'application (équivalent à <code>docker compose exec redis redis-cli flushall</code>).
                    </p>
                    <form action="{{ path('admin_redis_flush') }}" method="POST" onsubmit="return confirm('Voulez-vous vraiment vider le cache Redis (flushall) ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_redis_flush') }}">
                        <button type="submit" class="btn btn-danger w-100 fw-bold py-2 shadow-sm" style="border-radius: 8px;">
                            <i class="fas fa-trash-alt me-2"></i> Flush Redis (redis-cli flushall)
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}