{# templates/admin/barcode_management/pdf_print.html.twig #}
<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title>PDF - Impression du Code Barre</title>
    <style>
      body {
        font-family: Helvetica, sans-serif;
        margin: 0;
        padding: 0;
      }
      h1 {
        text-align: center;
        margin-bottom: 10mm;
      }
      /* On centre les étiquettes dans le conteneur */
      #barcode-container {
        text-align: center;
      }
      /* Définition d'une taille fixe pour l'étiquette */
      .barcode-label {
        display: inline-block;
        width: 50mm;       /* largeur standard */
        height: 30mm;      /* hauteur standard */
        margin: 3mm;       /* marge réduite pour permettre plusieurs étiquettes par rangée */
        text-align: center;
        border: 1px solid #ccc; /* facultatif pour visualiser les limites */
        padding: 2mm;
        box-sizing: border-box;
        vertical-align: top;
      }
      /* Pour agrandir l'image du code barre */
      .barcode-label img {
        width: 140pt;   /* l'image occupe 90% de la largeur de l'étiquette */
        height: 50pt; /* hauteur auto pour conserver le ratio */
        display: block;
        margin: 0 auto;
      }
      /* Réduire la taille du texte dans l'étiquette */
      .barcode-label p {
        margin: 0;
        font-size: 8pt;  /* taille de police réduite */
      }
    </style>
  </head>
  <body>
    <h1>Impression du Code Barre pour {{ product.name }}</h1>
    <div id="barcode-container">
      {% for i in 1..copies %}
        <div class="barcode-label">
          <img src="data:image/png;base64,{{ barcodeImage }}" alt="Code Barre">
          <p>{{ product.barcode }}</p>
        </div>
      {% endfor %}
    </div>
  </body>
</html>
