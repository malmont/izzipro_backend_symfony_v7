{% extends 'base_admin.html.twig' %}

{% block title %}Gestion des Codes-Barres{% endblock %}

{% block body %}
<div class="container-fluid">
    <h1 class="mb-4">Gestion des Codes-Barres</h1>

    {# Recherche et filtre (lot CB-2) : nom, code d'article, code-barres ou identifiant d'article #}
    <form method="get" action="{{ path('admin_barcode_management') }}" class="mb-3">
        <div class="form-group row align-items-center">
            <label for="search" class="col-sm-2 col-form-label">Rechercher</label>
            <div class="col-sm-5">
                <input type="text" id="search" name="search" class="form-control" placeholder="Nom, code d'article ou code-barres (scannez ici)" value="{{ search }}">
            </div>
            <div class="col-sm-3">
                <label class="mb-0"><input type="checkbox" name="missing" value="1" {{ missingOnly ? 'checked' }}> Seulement sans code-barres</label>
            </div>
            <div class="col-sm-2">
                <button type="submit" class="btn btn-primary">Rechercher</button>
            </div>
        </div>
    </form>

    {# Flash messages avec bouton de fermeture #}
    {% for flash_message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ flash_message }}
            <button type="button" class="close" data-dismiss="alert" aria-label="Fermer">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    {% endfor %}
    {% for flash_message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ flash_message }}
            <button type="button" class="close" data-dismiss="alert" aria-label="Fermer">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    {% endfor %}

    {# Lot CB-1 : « Générer les codes manquants », sur tout le catalogue, avec le nombre annoncé avant d'écrire #}
    {% if missing is defined %}
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5">Codes manquants</h2>
            {% if missing.total == 0 %}
                <p class="mb-0 text-muted">Toutes les variantes et tous les articles sans variante ont un code-barres.</p>
            {% else %}
                <p>
                    <strong>{{ missing.variants }}</strong> variante(s) et <strong>{{ missing.products }}</strong> article(s) sans variante n'ont pas de code-barres.
                    La génération leur donne un code interne de 13 chiffres (EAN-13), lisible par tout lecteur.
                    Elle ne remplace jamais un code déjà saisi ; un article qui a des variantes reçoit ses codes sur ses variantes.
                    {% if missing.total > bulkLimit %}Un lancement écrit au plus {{ bulkLimit }} codes : relancez pour la suite.{% endif %}
                </p>
                <form method="post" action="{{ path('admin_barcode_generate_missing') }}"
                      onsubmit="return confirm('Générer {{ min(missing.total, bulkLimit) }} code(s)-barres ? Les codes déjà saisis ne sont pas touchés.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('catalog_barcode_generate_missing') }}">
                    <button type="submit" class="btn btn-primary">Générer les codes manquants ({{ min(missing.total, bulkLimit) }})</button>
                </form>
            {% endif %}
        </div>
    </div>
    {% endif %}

    {# Lot CB-2 : une ligne par variante et par article sans variante ; un nombre d'étiquettes par ligne, puis impression de la sélection #}
    <form method="post" action="{{ path('admin_barcode_print') }}" target="_blank">
        <input type="hidden" name="search" value="{{ search }}">
        <input type="hidden" name="missing" value="{{ missingOnly ? '1' : '' }}">
        <input type="hidden" name="page" value="{{ page }}">
        <div class="d-flex align-items-center mb-2">
            <span class="mr-3">{{ total }} ligne(s){% if pages > 1 %}, page {{ page }} sur {{ pages }}{% endif %}</span>
            <label class="mb-0 mr-3"><input type="checkbox" name="showPrice" value="1"> Prix sur l'étiquette</label>
            <button type="submit" name="output" value="html" class="btn btn-primary mr-2">Imprimer la sélection</button>
            <button type="submit" name="output" value="pdf" class="btn btn-secondary mr-3">PDF de la sélection</button>
            <span class="text-muted">Étiquettes 50 × 30 mm, {{ maxLabels }} au plus par impression.</span>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="thead-dark">
                    <tr>
                        <th>Article</th>
                        <th>Variante</th>
                        <th>Code d'article</th>
                        <th>Code-barres</th>
                        <th>Prix</th>
                        <th>Nombre d'étiquettes</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr data-key="{{ row.key }}">
                            <td>{{ row.title }}</td>
                            <td>{% if row.type == 'product' %}<span class="text-muted">sans variante</span>{% else %}{{ row.subtitle ?: 'variante n° ' ~ row.id }}{% endif %}</td>
                            <td>{{ row.code }}</td>
                            <td>
                                {% if row.barcode %}
                                    <code>{{ row.barcode }}</code>
                                    <span class="text-muted">{{ row.symbology == 'ean13' ? 'EAN-13' : 'Code 128' }}{% if row.barcodeOf == 'product' and row.type == 'variant' %}, code de l'article{% endif %}</span>
                                {% else %}
                                    <span class="text-muted">Aucun code-barres</span>
                                {% endif %}
                            </td>
                            <td>{% if row.priceCents is not null %}{{ (row.priceCents / 100)|number_format(2, ',', ' ') }} {{ currency }}{% endif %}</td>
                            <td>
                                {% if row.barcode %}
                                    <input type="number" name="copies[{{ row.key }}]" min="0" max="{{ maxLabels }}" value="0" class="form-control" style="width: 90px;">
                                {% else %}
                                    <span class="text-muted">à générer d'abord</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center">Aucune ligne trouvée.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </form>
    {% if pages > 1 %}
        <nav aria-label="Pages">
            <ul class="pagination">
                {% set query = {'search': search}|merge(missingOnly ? {'missing': '1'} : {}) %}
                <li class="page-item {{ page <= 1 ? 'disabled' }}"><a class="page-link" href="{{ path('admin_barcode_management', query|merge({'page': page - 1})) }}">Précédente</a></li>
                <li class="page-item disabled"><span class="page-link">{{ page }} / {{ pages }}</span></li>
                <li class="page-item {{ page >= pages ? 'disabled' }}"><a class="page-link" href="{{ path('admin_barcode_management', query|merge({'page': page + 1})) }}">Suivante</a></li>
            </ul>
        </nav>
    {% endif %}
</div>
{% endblock %}
