{% extends 'base_admin.html.twig' %}

{% block title %}Gestion des Codes-Barres{% endblock %}

{% block body %}
<div class="container-fluid">
    <h1 class="mb-4">Gestion des Codes-Barres</h1>

    {# Formulaire de recherche #}
    <form method="get" action="{{ path('admin_barcode_management_search') }}" class="mb-3">
        <div class="form-group row">
            <label for="search" class="col-sm-2 col-form-label">Rechercher</label>
            <div class="col-sm-6">
                <input type="text" id="search" name="search" class="form-control" placeholder="Id ou nom de l'article" value="{{ app.request.get('search') }}">
            </div>
            <div class="col-sm-2">
                <button type="submit" class="btn btn-primary">Rechercher</button>
            </div>
        </div>
    </form>

    {# Flash messages avec bouton de fermeture #}
    {% for flash_message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ flash_message }}
            <button type="button" class="close" data-dismiss="alert" aria-label="Fermer">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    {% endfor %}
    {% for flash_message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ flash_message }}
            <button type="button" class="close" data-dismiss="alert" aria-label="Fermer">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    {% endfor %}

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>Id</th>
                    <th>Produit</th>
                    <th>Photo de l'article</th>
                    <th>Code Barre (texte)</th>
                    <th>Image Code Barre</th>
                    <th>Nombre à imprimer</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for product in products %}
                    <tr>
                        <td>{{ product.id }}</td>
                        <td>{{ product.name }}</td>
                        <td>
                            {% if product.image %}
                                <img src="{{ asset('assets/uploads/products/' ~ product.image) }}" alt="Photo de l'article" style="width: 150px; height: auto;">
                            {% else %}
                                <span class="text-muted">Aucune photo</span>
                            {% endif %}
                        </td>
                        <td>{{ product.barcode }}</td>
                        <td>
                            {% if product.barcode %}
                                <img src="{{ path('admin_barcode_image', {'id': product.id}) }}" alt="Code Barre" style="width: 150px; height: 50px;">
                            {% else %}
                                <span class="text-muted">Aucun code barre</span>
                            {% endif %}
                        </td>
                        <td>
                            <form method="post" action="{{ path('admin_barcode_management') }}" class="form-inline">
                                <input type="hidden" name="product_id" value="{{ product.id }}">
                                <div class="form-group mr-2">
                                    <input type="number" name="copies" min="1" value="1" required class="form-control" style="width: 70px;">
                                </div>
                        </td>
                        <td>
                            {% if product.barcode %}
                                <div class="btn-group" role="group">
                                    <button type="submit" name="printType" value="html" class="btn btn-primary">Imprimer HTML</button>
                                    <button type="submit" name="printType" value="pdf" class="btn btn-secondary">Générer PDF</button>
                                </div>
                            {% else %}
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-primary" disabled>Imprimer HTML</button>
                                    <button type="button" class="btn btn-secondary" disabled>Générer PDF</button>
                                </div>
                            {% endif %}
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center">Aucun produit trouvé.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
