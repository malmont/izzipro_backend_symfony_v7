{# Contrôles du site (07/11/2026) : habillage EasyAdmin depuis le menu, sinon page nue #}
{% extends ea() is not null ? '@EasyAdmin/page/content.html.twig' : 'base_admin.html.twig' %}

{% block title %}Contrôles{% endblock %}
{% block content_title %}Contrôles : ce qui cloche dans vos données{% endblock %}
{% block main %}{{ block('panel') }}{% endblock %}
{% block body %}{% if ea() is null %}<div class="py-3">{{ block('panel') }}</div>{% else %}{{ parent() }}{% endif %}{% endblock %}

{% block panel %}
<div class="container-fluid" style="max-width: 980px" data-controles data-problems="{{ overview.problems }}" data-warnings="{{ overview.warnings }}">
    <h1 class="h3 mb-1">Contrôles</h1>
    <p class="text-muted">Le cheminement dit quoi configurer ; cette page dit ce qui cloche au quotidien : produits invendables, stocks négatifs, commandes en retard, avis en attente… Rouge = bloque une vente ou un client, orange = à regarder, vert = rien à signaler.</p>
    {% for label, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ label }}">{{ message }}</div>{% endfor %}{% endfor %}
    <div class="mb-3">
        {% if overview.problems > 0 %}<span class="badge bg-danger">{{ overview.problems }} problème{{ overview.problems > 1 ? 's' : '' }}</span>{% endif %}
        {% if overview.warnings > 0 %}<span class="badge bg-warning text-dark">{{ overview.warnings }} point{{ overview.warnings > 1 ? 's' : '' }} à regarder</span>{% endif %}
        {% if overview.problems == 0 and overview.warnings == 0 %}<span class="badge bg-success">Tout est en ordre</span>{% endif %}
    </div>
    <div class="card"><div class="card-body">
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th></th><th>Contrôle</th><th class="text-end">Cas</th><th>Pourquoi</th><th></th></tr></thead>
            <tbody>
            {% for ctl in overview.controls %}
                <tr data-control="{{ ctl.key }}" data-severity="{{ ctl.severity }}">
                    <td><span class="badge bg-{{ ctl.severity == 'problem' ? 'danger' : (ctl.severity == 'warning' ? 'warning text-dark' : 'success') }} rounded-pill">&nbsp;</span></td>
                    <td>{{ ctl.title }}</td>
                    <td class="text-end"><strong>{{ ctl.count }}</strong></td>
                    <td class="small text-muted">{{ ctl.description }}</td>
                    <td class="text-nowrap">{% if ctl.url and ctl.count > 0 %}<a href="{{ ctl.url }}">→ corriger</a>{% endif %}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div></div>
</div>
{% endblock %}
