{% extends ea() is not null ? '@EasyAdmin/page/content.html.twig' : 'base_admin.html.twig' %}
{# Lot AG-3c : le sélecteur de sites d'EasyAdmin, même liste que la gestion web (/api/me/contexts) #}
{% block title %}{{ mode == 'super_admin' ? 'Tous les sites' : 'Les sites de mes clients' }}{% endblock %}
{% block content_title %}{{ mode == 'super_admin' ? 'Tous les sites' : 'Les sites de mes clients' }}{% endblock %}

{% block main %}{{ block('panel') }}{% endblock %}
{% block body %}{% if ea() is null %}<div class="container py-3">{{ block('panel') }}</div>{% else %}{{ parent() }}{% endif %}{% endblock %}

{% block panel %}
    {% if not otpFresh %}
        <div class="alert alert-warning">Entrer dans un autre site demande un code validé depuis moins de 12 heures. Déconnectez-vous puis reconnectez-vous avec votre code. Si aucun code ne vous est demandé à la connexion, activez-le sur votre compte.</div>
    {% endif %}
    {% if sites is empty %}
        <p class="text-muted">Aucun site à ouvrir.</p>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead><tr><th>Site</th><th>État</th><th>Modules</th>{% if clients is not empty %}<th>Ouverture</th><th>Invitation</th><th>Essais</th><th>Dernière entrée</th>{% endif %}<th></th></tr></thead>
                <tbody>
                {% for site in sites %}
                    <tr>
                        <td><strong>{{ site.name }}</strong><br><small class="text-muted">{{ site.code }}</small></td>
                        <td>{{ site.state ?? '' }}{% for badge in site.badges ?? [] %} <span class="badge bg-secondary">{{ badge.label ?? badge.key ?? '' }}</span>{% endfor %}</td>
                        <td><small>{{ site.modules|join(', ') }}</small></td>
                        {% if clients is not empty %}{% set c = clients[site.code] ?? null %}
                        <td><small>{% if c and c.checklist %}{{ c.checklist.blocking }} bloquant(s), {{ c.checklist.improvements }} amélioration(s){% endif %}{% if c and c.assistance %}<br>{{ c.assistance }} assistance(s){% endif %}</small></td>
                        <td><small>{% if c and c.invitation %}{{ {'pending': 'en attente', 'accepted': 'acceptée', 'expired': 'expirée', 'not_sent': 'non envoyée'}[c.invitation.state] ?? c.invitation.state }}{% if c.invitation.expiresAt %} (jusqu'au {{ c.invitation.expiresAt|date('d/m') }}){% endif %}{% endif %}</small></td>
                        <td><small>{% for t in c.trials ?? [] %}{{ t.feature }} → {{ t.endsAt|date('d/m') }}<br>{% endfor %}</small></td>
                        <td><small>{% if c and c.lastEntry %}{{ c.lastEntry.at|date('d/m H:i') }}, {{ c.lastEntry.firstName }}{% endif %}</small></td>
                        {% endif %}
                        <td class="text-end">
                            {% if site.screens is not empty and canEnter %}
                                <form method="post" action="{{ path('admin_contextes_entrer') }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_contextes_entrer') }}">
                                    <input type="hidden" name="site" value="{{ site.code }}">
                                    <button type="submit" class="btn btn-primary btn-sm" {{ otpFresh ? '' : 'disabled' }}>Entrer</button>
                                </form>
                            {% else %}
                                <span class="text-muted small">aucun écran ouvert</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <p class="small text-muted">Chaque entrée est tracée dans la base de la plateforme et au journal du site visé (« Accès extérieurs »). Elle dure une heure au plus.</p>
    {% endif %}
{% endblock %}
