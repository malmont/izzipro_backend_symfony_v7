{# Lot BANDEAU (18/11/2026) : sur toutes les pages d'EasyAdmin pendant une entrée dans un autre site #}
{% set banner = admin_entry_banner() %}
{% if banner %}
<div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3" data-entry-banner>
    <span>
        Vous êtes dans <strong data-entry-site>{{ banner.siteName }}</strong>{% if banner.host %} ({{ banner.host }}){% endif %}
        en tant que <strong data-entry-as>{{ banner.as }}</strong>.
        <small class="text-muted">Entrée tracée depuis {{ banner.homeName }}{% if banner.expiresAt %}, jusqu'à {{ banner.expiresAt|date('H:i', 'UTC') }} (UTC){% endif %}.</small>
    </span>
    <form method="post" action="{{ path('admin_entree_quitter') }}" class="m-0">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_entree_quitter') }}">
        <button type="submit" class="btn btn-sm btn-outline-danger" data-entry-quit>Quitter {{ banner.siteName }} (retour à la connexion de {{ banner.homeName }})</button>
    </form>
</div>
{% endif %}
