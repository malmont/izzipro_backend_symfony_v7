<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         bootstrap="tests/bootstrap.php"
         cacheResultFile="var/cache/.phpunit.result.cache"
         convertDeprecationsToExceptions="false"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <!-- débogage coupé dans le conteneur (APP_DEBUG=0, 17/10/2026) ; une variable d'environnement passe avant .env.test :
             forcé ici pour les tests seulement, sinon leur cache (description des entités Doctrine…) ne suit plus le code
             (25/10/2026). Le site, lui, reste sans débogage. -->
        <env name="APP_DEBUG" value="1" force="true" />
        <server name="APP_DEBUG" value="1" force="true" />
        <!-- débogage coupé dans le conteneur (APP_DEBUG=0, 17/10/2026) ; une variable d'environnement passe avant .env.test :
             forcé ici, sinon le cache des tests (description des entités Doctrine…) ne suit plus le code (25/10/2026) -->
        <env name="APP_DEBUG" value="1" force="true" />
        <server name="APP_DEBUG" value="1" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <!-- code par e-mail activé en production (.env du conteneur) : les tests qui le veulent l'activent eux-mêmes -->
        <env name="ADMIN_OTP_REQUIRED" value="0" force="true" />
        <server name="ADMIN_OTP_REQUIRED" value="0" force="true" />
        <!-- modèle des requêtes avec images choisi en production : les tests partent du réglage par défaut -->
        <env name="LANDING_AI_MODEL_IMAGES" value="" force="true" />
        <server name="LANDING_AI_MODEL_IMAGES" value="" force="true" />
        <!-- clés RevenueCat réelles dans le .env du conteneur : les tests gardent le secret simulé et aucune clé d'API -->
        <env name="REVENUECAT_WEBHOOK_SECRET" value="test-webhook-secret" force="true" />
        <server name="REVENUECAT_WEBHOOK_SECRET" value="test-webhook-secret" force="true" />
        <env name="REVENUECAT_SECRET_KEY" value="" force="true" />
        <server name="REVENUECAT_SECRET_KEY" value="" force="true" />
        <server name="SYMFONY_PHPUNIT_REMOVE" value="" />
        <server name="SYMFONY_PHPUNIT_VERSION" value="9.5" />
    </php>

    <testsuites>
        <testsuite name="Project Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <directory suffix=".php">src/Entity</directory>
            <directory suffix=".php">src/Dto</directory>
            <directory suffix=".php">src/Repository</directory>
            <directory suffix=".php">src/Form</directory>
            <directory suffix=".php">src/Exception</directory>
            <directory suffix=".php">src/Enum</directory>
            <directory suffix=".php">src/Serializer</directory>
            <directory suffix=".php">src/Command</directory>
            <file>src/Kernel.php</file>
        </exclude>
    </coverage>

    <listeners>
        <listener class="Symfony\Bridge\PhpUnit\SymfonyTestsListener" />
        <!-- connexions à PostgreSQL libérées après chaque test (serveur partagé avec la production) -->
        <listener class="App\Tests\ReleaseTestResourcesListener" />
    </listeners>

    <!-- Run `composer require symfony/panther` before enabling this extension -->
    <!--
    <extensions>
        <extension class="Symfony\Component\Panther\ServerExtension" />
    </extensions>
    -->
</phpunit>
